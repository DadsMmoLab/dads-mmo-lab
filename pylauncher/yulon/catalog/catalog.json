    {
      "id": "wow-tortoise",
      "name": "WoW Tortoise",
      "status": "wip",
      "description": "Tortoise (the Turtle-WoW solo fork on MaNGOS Zero) with the cmangos playerbots AI, source-compiled in Docker. This is the tree the Turtle WoW V2 servers are built from. Installer is work-in-progress and unverified with a real client.",
      "emulator": {
        "name": "Shyalya/tortoise-wow (Turtle-WoW V2 + cmangos playerbots)",
        "sources": [
          {
            "repo": "Shyalya/tortoise-wow",
            "branch": "playerbots-integration-gh",
            "dest": "src/tortoise-wow"
          },
          {
            "repo": "ElunaLuaEngine/Eluna",
            "dest": "src/tortoise-wow/src/modules/Eluna",
            "rev": "1b06f28ff3a00054d915d824c725fb4283fee74d"
          }
        ]
      },
      "install": {
        "platforms": [
          "linux"
        ],
        "default_server_dir": "tortoise-wow-server",
        "requires_client_dir": true,
        "password": {
          "mode": "generated",
          "file": ".db_password",
          "prefix": "tortoise-"
        },
        "native": {
          "family": "cmangos",
          "templates": "shared/cmangos",
          "dockerfile_dir": "wow-tortoise/native",
          "image_prefix": "yulon.local/cmangos-tortoise-",
          "images": [
            "server"
          ],
          "min_ram_gb": 6,
          "warn_ram_gb": 8,
          "min_data_root_gb": 20,
          "warn_data_root_gb": 30,
          "min_server_dir_gb": 20,
          "warn_server_dir_gb": 30,
          "db": {
            "image": "mariadb:10.6",
            "client": "mariadb",
            "user": "mangos",
            "charset": "utf8mb4"
          },
          "ready": {
            "world": "World server is up and running|World initialized|MaNGOS.*started up successfully|Ready to login",
            "auth": null,
            "fatal": "Correct \\*.map files not found|Could not open|Database .* not found",
            "regex": true,
            "timeout_s": 1800,
            "restart_loop": 4
          },
          "cmangos": {
            "client": {
              "required_file": null,
              "min_mpq": 5,
              "mpq_depth": 2,
              "locale_mpq_required": false,
              "near_client_warn_gb": 8
            },
            "dockerfile": {
              "make_jobs": 2
            },
            "extract": {
              "image": "server",
              "ulimit_stack_unlimited": false,
              "tools": [
                {
                  "name": "maps and dbc",
                  "argv": [
                    "/opt/tortoise/bin/mapextractor",
                    "-i",
                    "/client",
                    "-o",
                    "/out",
                    "-e",
                    "3"
                  ],
                  "produces": {
                    "dbc": 100,
                    "maps": 100
                  }
                },
                {
                  "name": "vmap extract",
                  "argv": [
                    "/opt/tortoise/bin/vmapextractor",
                    "-d",
                    "/client/Data/"
                  ],
                  "produces": {
                    "Buildings": 100
                  }
                },
                {
                  "name": "vmap assemble",
                  "argv": [
                    "/opt/tortoise/bin/vmap_assembler",
                    "/out/Buildings",
                    "/out/vmaps"
                  ],
                  "produces": {
                    "vmaps": 100
                  }
                }
              ]
            },
            "mmaps": {
              "argv": [
                "/opt/tortoise/bin/MoveMapGen",
                "--silent",
                "--doNotFilterDeepWater",
                "--offMeshInput",
                "/opt/tortoise/src/tools/mmap/offmesh.txt",
                "--settingsInput",
                "/opt/tortoise/src/tools/mmap/mmapSettings.txt"
              ],
              "min_files": 500,
              "required": false,
              "success_codes": [1]
            },
            "conf": {
              "source_dir": "/opt/tortoise/etc",
              "files": {
                "aiplayerbot.conf": {
                  "keys": {
                    "AiPlayerbot.MinRandomBots": "500",
                    "AiPlayerbot.MaxRandomBots": "500",
                    "AiPlayerbot.RandomBotAccountCount": "100"
                  }
                },
                "mangosd.conf": {
                  "keys": {
                    "LoginDatabase.Info": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{AUTH_DB}}\"",
                    "WorldDatabase.Info": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{WORLD_DB}}\"",
                    "CharacterDatabase.Info": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{CHAR_DB}}\"",
                    "LogsDatabase.Info": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{LOGS_DB}}\"",
                    "Database.AutoUpdate.Path": "\"/opt/tortoise/sql/database_updates/\"",
                    "DataDir": "\"/opt/tortoise/data\"",
                    "WorldServerPort": "{{WORLD_PORT}}",
                    "GameType": "0",
                    "GM.LoginState": "0",
                    "GM.StartLevel": "1",
                    "AutoHonorRestart": "0",
                    "AutoRestart.MaxServerUptime": "0"
                  }
                },
                "realmd.conf": {
                  "keys": {
                    "LoginDatabaseInfo": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{AUTH_DB}}\"",
                    "ForcePinAccountRank": "10"
                  }
                }
              }
            },
            "sql": {
              "create": [],
              "phases": [
                {
                  "name": "schemas",
                  "files": [
                    "src/tortoise-wow/sql/create_databases.sql"
                  ],
                  "on_error": "fail"
                },
                {
                  "name": "app user and grants",
                  "statements": [
                    "CREATE USER IF NOT EXISTS '{{DB_USER}}'@'%' IDENTIFIED BY '{{DB_PASSWORD}}'",
                    "GRANT ALL ON `{{WORLD_DB}}`.* TO '{{DB_USER}}'@'%'",
                    "GRANT ALL ON `{{CHAR_DB}}`.* TO '{{DB_USER}}'@'%'",
                    "GRANT ALL ON `{{AUTH_DB}}`.* TO '{{DB_USER}}'@'%'",
                    "GRANT ALL ON `{{LOGS_DB}}`.* TO '{{DB_USER}}'@'%'",
                    "FLUSH PRIVILEGES"
                  ],
                  "on_error": "fail"
                },
                {
                  "name": "world base",
                  "into": "tw_world",
                  "files": [
                    "src/tortoise-wow/sql/base/*.sql"
                  ],
                  "sort": "name",
                  "on_error": "fail"
                },
                {
                  "name": "realm row",
                  "into": "tw_logon",
                  "statements": [
                    "REPLACE INTO realmlist (id,name,address,port,icon,realmflags,timezone,allowedSecurityLevel,population,realmbuilds) VALUES (1, 'Tortoise WoW', '{{REALM_HOST}}', {{WORLD_PORT}}, 0,0,0,0,0, '{{CLIENT_BUILD}}')"
                  ],
                  "on_error": "fail"
                }
              ],
              "verify": [
                {
                  "db": "tw_world",
                  "query": "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='tw_world'",
                  "min": 150
                },
                {
                  "db": "tw_logon",
                  "query": "SELECT COUNT(*) FROM realmlist",
                  "min": 1
                }
              ],
              "player_data": [
                {
                  "db": "tw_char",
                  "table": "characters"
                },
                {
                  "db": "tw_logon",
                  "table": "account",
                  "exclude_usernames": [
                    "ADMINISTRATOR",
                    "GAMEMASTER",
                    "MODERATOR",
                    "PLAYER"
                  ]
                }
              ],
              "marker_db": "tw_world"
            }
          }
        }
      },
      "containers": {
        "db": "tortoise-db",
        "auth": "tortoise-realmd",
        "world": "tortoise-mangosd"
      },
      "ports": {
        "auth": 3724,
        "world": 8090,
        "db": 3306
      },
      "databases": {
        "auth": "tw_logon",
        "characters": "tw_char",
        "world": "tw_world",
        "extra": [
          "tw_logs"
        ]
      },
      "realmlist": {
        "table": "realmlist",
        "address_column": "address",
        "local_address_column": null
      },
      "accounts": {
        "scheme": "mangos_sha"
      },
      "console": {
        "prompt": "mangos>",
        "prompt_precedes_answer": false
      },
      "client": {
        "version": "1.18.1",
        "build": 7272,
        "notes": [
          "Only the custom Turtle-WoW 1.18.1 client (build 7272) works; any other build will not connect."
        ]
      }
    }
  ]
