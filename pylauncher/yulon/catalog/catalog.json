{
  "schema_version": 1,
  "games": [
    {
      "id": "wow-wotlk",
      "name": "WoW WotLK",
      "status": "stable",
      "description": "WotLK (3.3.5a) on AzerothCore with Playerbots. The flagship install; module/ALE/mod/keg management is manifest-driven.",
      "emulator": {
        "name": "AzerothCore (mod-playerbots fork) + mod-playerbots",
        "sources": [
          {
            "repo": "mod-playerbots/azerothcore-wotlk",
            "branch": "Playerbot",
            "depth": null,
            "dest": ".",
            "rev": "413bea61a85e20d9caef7d66fc601a661fdddd9d"
          },
          {
            "repo": "mod-playerbots/mod-playerbots",
            "branch": "master",
            "dest": "modules/mod-playerbots",
            "rev": "b949b50bfcdd4fab937781bac2d7765e39330e4b"
          }
        ]
      },
      "install": {
        "platforms": [
          "linux",
          "macos",
          "windows"
        ],
        "default_server_dir": "wow-server-playerbots",
        "password": {
          "mode": "fixed",
          "value": "password"
        },
        "native": {
          "family": "azerothcore",
          "templates": "wow-wotlk/native",
          "images": [
            "worldserver",
            "authserver",
            "db-import",
            "client-data"
          ],
          "image_prefix": "yulon.local/ac-wotlk-",
          "db": {
            "image": "mysql:8.4",
            "client": "mysql",
            "user": "root"
          },
          "ready": {
            "world": "ready...",
            "auth": "{{REALM_HOST}}:{{WORLD_PORT}}"
          },
          "azerothcore": {
            "world_env": {
              "AC_AI_PLAYERBOT_MIN_RANDOM_BOTS": "500",
              "AC_AI_PLAYERBOT_MAX_RANDOM_BOTS": "500"
            }
          }
        }
      },
      "containers": {
        "db": "ac-database",
        "auth": "ac-authserver",
        "world": "ac-worldserver",
        "db_import": "ac-db-import",
        "client_data": "ac-client-data-init"
      },
      "ports": {
        "auth": 3724,
        "world": 8085,
        "db": 3306
      },
      "databases": {
        "auth": "acore_auth",
        "characters": "acore_characters",
        "world": "acore_world",
        "extra": [
          "acore_playerbots"
        ],
        "playerbots": "acore_playerbots",
        "ale": "acore_ale"
      },
      "client": {
        "version": "3.3.5a",
        "build": 12340,
        "notes": [
          "set realmlist 127.0.0.1 (or the host's LAN/public IP for other players)"
        ]
      },
      "play": {
        "equipped": {
          "template_column": "itemEntry",
          "instance_table": "item_instance",
          "inventory_column": "item"
        },
        "teleport_command": "teleport name",
        "mail_item_cap": 12,
        "rename_command": "character rename",
        "set_level_command": "character level"
      },
      "accounts": {
        "level": {
          "table": "account_access",
          "account_column": "id",
          "level_column": "gmlevel",
          "max_level": 3
        }
      },
      "operations": {
        "channel": "soap",
        "namespace": "urn:AC",
        "port": 7878,
        "gm_level": 3,
        "enable_env": {
          "AC_SOAP_ENABLED": "1",
          "AC_SOAP_IP": "0.0.0.0",
          "AC_AI_PLAYERBOT_COMMAND_SERVER_PORT": "0",
          "AC_RA_ENABLE": "0"
        },
        "must_not_listen": [8888, 3443]
      },
      "observability": {
        "characters": {
          "table": "characters",
          "account": "account",
          "online": "online"
        },
        "bots": {
          "account_prefix": "rndbot",
          "prefix_conf_file": "env/dist/etc/modules/playerbots.conf",
          "prefix_conf_key": "AiPlayerbot.RandomBotAccountPrefix",
          "registry": {
            "database": "playerbots",
            "table": "playerbots_account_type",
            "account_column": "account_id",
            "type_column": "account_type",
            "types": [1, 2, 3]
          }
        }
      },
      "has_manifests": true
    },
    {
      "id": "wow-tbc",
      "name": "WoW TBC",
      "status": "beta",
      "description": "TBC (2.4.3) on CMaNGOS with the CMaNGOS playerbots fork.",
      "emulator": {
        "name": "CMaNGOS mangos-tbc + cmangos/playerbots + tbc-db",
        "sources": [
          {
            "repo": "cmangos/mangos-tbc",
            "dest": "src/mangos-tbc",
            "rev": "f82e7d679c283b66bc2adc1b751aa1275e655673"
          },
          {
            "repo": "cmangos/playerbots",
            "dest": "src/mangos-tbc/src/modules/Bots",
            "rev": "993f18091e67565986cf55c4d9b8e6eae11223f9"
          },
          {
            "repo": "cmangos/tbc-db",
            "dest": "src/tbc-db",
            "rev": "5078439a44d208732a903bca2d7df51941fb373a"
          }
        ]
      },
      "install": {
        "platforms": [
          "linux",
          "windows"
        ],
        "default_server_dir": "wow-tbc-server",
        "requires_client_dir": true,
        "password": {
          "mode": "generated",
          "file": ".db_password",
          "prefix": "tbc-"
        },
        "native": {
          "family": "cmangos",
          "templates": "shared/cmangos",
          "dockerfile_dir": "wow-tbc/native",
          "image_prefix": "yulon.local/cmangos-tbc-",
          "images": [
            "server"
          ],
          "min_ram_gb": 6,
          "warn_ram_gb": 8,
          "min_data_root_gb": 20,
          "warn_data_root_gb": 30,
          "min_server_dir_gb": 20,
          "warn_server_dir_gb": 30,
          "db": {
            "image": "mariadb:11",
            "client": "mariadb",
            "user": "mangos",
            "charset": "utf8mb4"
          },
          "ready": {
            "world": "Avg Diff:",
            "auth": null,
            "fatal": null,
            "regex": false,
            "timeout_s": 1800,
            "restart_loop": 4
          },
          "cmangos": {
            "client": {
              "required_file": "Data/expansion.MPQ",
              "min_mpq": 6,
              "mpq_depth": "recursive",
              "locale_mpq_required": true,
              "near_client_warn_gb": 8
            },
            "dockerfile": {
              "make_jobs": 2
            },
            "extract": {
              "image": "server",
              "ulimit_stack_unlimited": false,
              "tools": [
                {
                  "name": "dbc and maps",
                  "argv": [
                    "/opt/mangos/bin/tools/ad",
                    "-i",
                    "/client",
                    "-o",
                    "/out"
                  ],
                  "produces": {
                    "dbc": 100,
                    "maps": 100
                  }
                },
                {
                  "name": "vmap extract",
                  "argv": [
                    "/opt/mangos/bin/tools/vmap_extractor",
                    "-d",
                    "/client/Data"
                  ],
                  "produces": {
                    "Buildings": 100
                  }
                },
                {
                  "name": "vmap assemble",
                  "argv": [
                    "/opt/mangos/bin/tools/vmap_assembler",
                    "Buildings",
                    "vmaps"
                  ],
                  "produces": {
                    "vmaps": 100
                  }
                }
              ]
            },
            "mmaps": {
              "argv": [
                "/opt/mangos/bin/tools/MoveMapGen",
                "--silent",
                "--threads",
                "2"
              ],
              "min_files": 500,
              "required": true
            },
            "conf": {
              "source_dir": "/opt/mangos/etc",
              "files": {
                "mangosd.conf": {
                  "keys": {
                    "LoginDatabaseInfo": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{AUTH_DB}}\"",
                    "WorldDatabaseInfo": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{WORLD_DB}}\"",
                    "CharacterDatabaseInfo": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{CHAR_DB}}\"",
                    "LogsDatabaseInfo": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{LOGS_DB}}\"",
                    "DataDir": "\"/opt/mangos/data\"",
                    "WorldServerPort": "{{WORLD_PORT}}"
                  }
                },
                "realmd.conf": {
                  "keys": {
                    "LoginDatabaseInfo": "\"{{DB_HOST}};3306;{{DB_USER}};{{DB_PASSWORD}};{{AUTH_DB}}\""
                  }
                },
                "aiplayerbot.conf": {
                  "keys": {
                    "AiPlayerbot.MinRandomBots": "500",
                    "AiPlayerbot.MaxRandomBots": "500",
                    "AiPlayerbot.RandomBotAccountCount": "100"
                  }
                },
                "ahbot.conf": {
                  "keys": {
                    "AuctionHouseBot.Chance.Sell": "75",
                    "AuctionHouseBot.Loot.Creature.Normal": "90, 100, 30, 40",
                    "AuctionHouseBot.Loot.Creature.Rare": "0, 30, 1, 2",
                    "AuctionHouseBot.Loot.Creature.Elite": "80, 90, 4, 6",
                    "AuctionHouseBot.Loot.Creature.RareElite": "0, 15, 1, 2",
                    "AuctionHouseBot.Loot.Creature.WorldBoss": "-10, 2, 1, 1",
                    "AuctionHouseBot.Loot.Disenchant": "40, 50, 2, 3",
                    "AuctionHouseBot.Loot.Fishing": "12, 18, 100, 150",
                    "AuctionHouseBot.Loot.Gameobject": "50, 60, 30, 45",
                    "AuctionHouseBot.Loot.Skinning": "12, 18, 200, 250",
                    "AuctionHouseBot.Items.Profession": "250, 300, 0, 50"
                  }
                }
              }
            },
            "sql": {
              "create": [
                "mangos",
                "realmd",
                "characters",
                "logs"
              ],
              "phases": [
                {
                  "name": "realmd base",
                  "into": "realmd",
                  "files": [
                    "src/mangos-tbc/sql/base/realmd.sql"
                  ],
                  "on_error": "fail"
                },
                {
                  "name": "characters base",
                  "into": "characters",
                  "files": [
                    "src/mangos-tbc/sql/base/characters.sql"
                  ],
                  "on_error": "fail"
                },
                {
                  "name": "logs base",
                  "into": "logs",
                  "files": [
                    "src/mangos-tbc/sql/base/logs.sql"
                  ],
                  "on_error": "fail"
                },
                {
                  "name": "world content",
                  "into": "mangos",
                  "files": [
                    "src/tbc-db/Full_DB/TBCDB_*.sql.gz"
                  ],
                  "gzip": true,
                  "on_error": "fail"
                },
                {
                  "name": "content updates",
                  "into": "mangos",
                  "files": [
                    "src/tbc-db/Updates/*.sql"
                  ],
                  "sort": "natural",
                  "on_error": "warn"
                },
                {
                  "name": "ACID",
                  "into": "mangos",
                  "files": [
                    "src/tbc-db/ACID/*.sql"
                  ],
                  "on_error": "warn"
                },
                {
                  "name": "dbc data",
                  "into": "mangos",
                  "files": [
                    "src/mangos-tbc/sql/base/dbc/original_data/*.sql",
                    "src/mangos-tbc/sql/base/dbc/cmangos_fixes/*.sql"
                  ],
                  "on_error": "warn"
                },
                {
                  "name": "core updates",
                  "assert_update_level": true,
                  "into_each": {
                    "mangos": "src/mangos-tbc/sql/updates/mangos/*.sql",
                    "realmd": "src/mangos-tbc/sql/updates/realmd/*.sql",
                    "characters": "src/mangos-tbc/sql/updates/characters/*.sql",
                    "logs": "src/mangos-tbc/sql/updates/logs/*.sql"
                  },
                  "sort": "natural",
                  "on_error": "warn"
                },
                {
                  "name": "spell_template hotfix",
                  "into": "mangos",
                  "statements": [
                    "ALTER TABLE spell_template ADD COLUMN IF NOT EXISTS EffectBonusCoefficient1 FLOAT NOT NULL DEFAULT '0' AFTER RequiredAuraVision, ADD COLUMN IF NOT EXISTS EffectBonusCoefficient2 FLOAT NOT NULL DEFAULT '0' AFTER EffectBonusCoefficient1, ADD COLUMN IF NOT EXISTS EffectBonusCoefficient3 FLOAT NOT NULL DEFAULT '0' AFTER EffectBonusCoefficient2, ADD COLUMN IF NOT EXISTS EffectBonusCoefficientFromAP1 FLOAT NOT NULL DEFAULT '0' AFTER EffectBonusCoefficient3, ADD COLUMN IF NOT EXISTS EffectBonusCoefficientFromAP2 FLOAT NOT NULL DEFAULT '0' AFTER EffectBonusCoefficientFromAP1, ADD COLUMN IF NOT EXISTS EffectBonusCoefficientFromAP3 FLOAT NOT NULL DEFAULT '0' AFTER EffectBonusCoefficientFromAP2"
                  ],
                  "on_error": "warn"
                },
                {
                  "name": "playerbots characters",
                  "into": "characters",
                  "files": [
                    "src/mangos-tbc/src/modules/Bots/sql/characters/*.sql"
                  ],
                  "on_error": "warn"
                },
                {
                  "name": "playerbots world",
                  "into": "mangos",
                  "files": [
                    "src/mangos-tbc/src/modules/Bots/sql/world/*.sql",
                    "src/mangos-tbc/src/modules/Bots/sql/world/tbc/*.sql"
                  ],
                  "on_error": "warn"
                },
                {
                  "name": "expansion unlock",
                  "into": "realmd",
                  "statements": [
                    "ALTER TABLE account MODIFY COLUMN expansion TINYINT(3) UNSIGNED NOT NULL DEFAULT 1",
                    "UPDATE account SET expansion = 1"
                  ],
                  "on_error": "fail"
                }
              ],
              "verify": [
                {
                  "db": "mangos",
                  "query": "SELECT COUNT(*) FROM item_template",
                  "min": 10000
                },
                {
                  "db": "mangos",
                  "query": "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='mangos' AND table_name LIKE 'ai_playerbot%'",
                  "min": 10
                }
              ],
              "player_data": [
                {
                  "db": "characters",
                  "table": "characters"
                },
                {
                  "db": "realmd",
                  "table": "account",
                  "exclude_usernames": [
                    "ADMINISTRATOR",
                    "GAMEMASTER",
                    "MODERATOR",
                    "PLAYER"
                  ]
                }
              ],
              "marker_db": "mangos"
            },
            "patches": [
              {
                "file": "shared/cmangos/patches/vmap-extractor-doodad-name-case.patch",
                "source": "src/mangos-tbc",
                "reason": "vmap_extractor writes WMO doodad models under their raw MODN name and looks them up under the normalised one, so on a case-sensitive filesystem WMO doodad placements are dropped silently; TBC's own loss was never counted, and the functions this patch edits are byte-identical to the mangos-classic ones where it was (pyplan/upstream-cmangos-doodad-drop.md)"
              }
            ]
          }
        }
      },
      "containers": {
        "db": "tbc-db",
        "auth": "tbc-realmd",
        "world": "tbc-mangosd"
      },
      "ports": {
        "auth": 3724,
        "world": 8085,
        "db": 3306
      },
      "databases": {
        "auth": "realmd",
        "characters": "characters",
        "world": "mangos",
        "extra": [
          "logs"
        ]
      },
      "realmlist": {
        "table": "realmlist",
        "address_column": "address",
        "local_address_column": null
      },
      "play": {
        "equipped": { "template_column": "item_template" },
        "teleport_command": "tele name",
        "mail_item_cap": 12,
        "rename_command": "character rename",
        "set_level_command": "character level"
      },
      "accounts": {
        "level": { "level_column": "gmlevel", "max_level": 3 },
        "scheme": "mangos_srp6"
      },
      "console": {
        "prompt": "mangos>",
        "prompt_precedes_answer": false
      },
      "operations": {
        "channel": "soap",
        "namespace": "urn:MaNGOS",
        "port": 7878,
        "gm_level": 3,
        "enable_conf": {
          "file": "etc/mangosd.conf",
          "keys": {
            "SOAP.Enabled": "1",
            "SOAP.IP": "0.0.0.0",
            "SOAP.Port": "7878",
            "Ra.Enable": "0"
          }
        },
        "publish": true,
        "must_not_listen": [
          8888,
          3443
        ]
      },
      "observability": {
        "characters": {
          "table": "characters",
          "account": "account",
          "online": "online"
        },
        "bots": {
          "account_prefix": "rndbot",
          "prefix_conf_file": "etc/aiplayerbot.conf",
          "prefix_conf_key": "AiPlayerbot.RandomBotAccountPrefix",
          "registry": null
        }
      },
      "client": {
        "version": "2.4.3",
        "build": 8606,
        "notes": [
          "A Vanilla client is the wrong version — the installer checks for this."
        ]
      },
      "has_manifests": true
    },
    {
      "id": "wow-vanilla",
      "name": "WoW Vanilla",
      "status": "beta",
      "description": "Vanilla (1.12.1) on CMaNGOS with the CMaNGOS playerbots fork.",
      "emulator": {
        "name": "CMaNGOS mangos-classic + cmangos/playerbots + classic-db",
        "sources": [
          {
            "repo": "cmangos/mangos-classic",
            "dest": "src/mangos-classic",
            "rev": "8ec338a1704e7dcb1c0213eb7ed58f9231ade40f"
          },
          {
            "repo": "cmangos/playerbots",
            "dest": "src/mangos-classic/src/modules/Bots",
            "rev": "993f18091e67565986cf55c4d9b8e6eae11223f9"
          },
          {
            "repo": "cmangos/classic-db",
            "dest": "src/classic-db",
            "rev": "22b51464f1625f6ef6275771de1f5466c6f5d19e"
          }
        ]
      },
      "install": {
        "platforms": [
          "linux",
          "windows"
        ],
        "default_server_dir": "wow-vanilla-server",
        "requires_client_dir": true,
        "password": {
          "mode": "generated",
          "file": ".db_password",
          "prefix": "vanilla-"
        },
        "native": {
          "family": "cmangos",
          "templates": "shared/cmangos",
          "dockerfile_dir": "wow-vanilla/native",
          "image_prefix": "yulon.local/cmangos-vanilla-",
          "images": [
            "server"
          ],
          "min_ram_gb": 6,
          "warn_ram_gb": 8,
          "min_data_root_gb": 20,
          "warn_data_root_gb": 30,
          "min_server_dir_gb": 20,
          "warn_server_dir_gb": 30,
          "db": {
            "image": "mariadb:11",
            "client": "mariadb",
            "user": "mangos",
            "charset": "utf8mb4"
          },
          "ready": {
            "world": "Avg Diff:",
            "auth": null,
            "fatal": null,
            "regex": false,
            "timeout_s": 1800,
            "restart_loop": 4
          },
          "cmangos": {
            "client": {
              "required_file": "Data/dbc.MPQ",
              "min_mpq": 5,
              "mpq_depth": 1,
              "locale_mpq_required": false,
              "near_client_warn_gb": 8
            },
            "dockerfile": {
              "make_jobs": 2
            },
            "extract": {
              "image": "server",
              "ulimit_stack_unlimited": true,
              "tools": [
                {
                  "name": "dbc and maps",
                  "argv": [
                    "/opt/mangos/bin/tools/ad",
                    "-i",
                    "/client",
                    "-o",
                    "/out"
                  ],
                  "produces": {
                    "dbc": 100,
                    "maps": 100
                  }
                },
                {
                  "name": "vmap extract",
                  "argv": [
                    "/opt/mangos/bin/tools/vmap_extractor",
                    "-d",
                    "/client/Data"
                  ],
                  "produces": {
                    "Buildings": 100
                  }
                },
                {
                  "name": "vmap assemble",
                  "argv": [
                    "/opt/mangos/bin/tools/vmap_assembler",
                    "Buildings",
                    "vmaps"
                  ],
                  "produces": {
                    "vmaps": 100
                  }
                }
              ],
              "retry": {
                "when_log_matches": "Segmentation fault|core dumped",
                "when_returncode_in": [139],
                "tools": [
                  "vmap extract",
                  "vmap assemble"
                ]
              }
            },
            "mmaps": {
              "argv": [
                "/opt/mangos/bin/tools/MoveMapGen",
