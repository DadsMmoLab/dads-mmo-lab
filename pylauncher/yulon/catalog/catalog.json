{
  "schema_version": 1,
  "games": [
    {
      "id": "wow-wotlk",
      "name": "WoW WotLK",
      "status": "stable",
      "description": "WotLK (3.3.5a) on AzerothCore with Playerbots. The flagship install; module/ALE/mod/keg management is manifest-driven.",
      "emulator": {
        "name": "AzerothCore (mod-playerbots fork) + mod-playerbots",
        "sources": [
          {
            "repo": "mod-playerbots/azerothcore-wotlk",
            "branch": "Playerbot",
            "depth": null,
            "dest": "."
          },
          {
            "repo": "mod-playerbots/mod-playerbots",
            "branch": "master",
            "dest": "modules/mod-playerbots"
          }
        ]
      },
      "install": {
        "platforms": [
          "linux",
          "macos",
          "windows"
        ],
        "script": "wow-wotlk/install-wow-wotlk.sh",
        "script_variants": {
          "apt": "wow-wotlk/install-wow-wotlk-ubuntu.sh",
          "dnf": "wow-wotlk/install-wow-wotlk-fedora.sh"
        },
        "default_server_dir": "wow-server-playerbots",
        "password": {
          "mode": "fixed",
          "value": "password"
        },
        "native": {
          "family": "azerothcore",
          "templates": "wow-wotlk/native",
          "images": [
            "worldserver",
            "authserver",
            "db-import",
            "client-data"
          ],
          "image_prefix": "yulon.local/ac-wotlk-",
          "db": {
            "image": "mysql:8.4",
            "client": "mysql",
            "user": "root"
          },
          "ready": {
            "world": "ready...",
            "auth": "{{REALM_HOST}}:{{WORLD_PORT}}"
          },
          "azerothcore": {
            "world_env": {
              "AC_AI_PLAYERBOT_MIN_RANDOM_BOTS": "500",
              "AC_AI_PLAYERBOT_MAX_RANDOM_BOTS": "500"
            }
          }
        }
      },
      "containers": {
        "db": "ac-database",
        "auth": "ac-authserver",
        "world": "ac-worldserver",
        "db_import": "ac-db-import",
        "client_data": "ac-client-data-init"
      },
      "ports": {
        "auth": 3724,
        "world": 8085,
        "db": 3306
      },
      "databases": {
        "auth": "acore_auth",
        "characters": "acore_characters",
        "world": "acore_world",
        "extra": [
          "acore_playerbots"
        ],
        "playerbots": "acore_playerbots",
        "ale": "acore_ale"
      },
      "client": {
        "version": "3.3.5a",
        "build": 12340,
        "notes": [
          "set realmlist 127.0.0.1 (or the host's LAN/public IP for other players)"
        ]
      },
      "has_manifests": true
    },
    {
      "id": "wow-tbc",
      "name": "WoW TBC",
      "status": "beta",
      "description": "TBC (2.4.3) on CMaNGOS with the CMaNGOS playerbots fork.",
      "emulator": {
        "name": "CMaNGOS mangos-tbc + cmangos/playerbots + tbc-db",
        "sources": [
          {
            "repo": "cmangos/mangos-tbc",
            "dest": "src/mangos-tbc"
          },
          {
            "repo": "cmangos/playerbots",
            "dest": "src/mangos-tbc/src/modules/Bots"
          },
          {
            "repo": "cmangos/tbc-db",
            "dest": "src/tbc-db"
          }
        ]
      },
      "install": {
        "platforms": [
          "linux"
        ],
        "script": "wow-tbc/install-wow-tbc.sh",
        "default_server_dir": "wow-tbc-server",
        "requires_client_dir": true,
        "password": {
          "mode": "generated",
          "file": ".db_password",
          "prefix": "tbc-"
        }
      },
      "containers": {
        "db": "tbc-db",
        "auth": "tbc-realmd",
        "world": "tbc-mangosd",
        "services": ["db", "realmd", "mangosd"]
      },
      "ports": {
        "auth": 3724,
        "world": 8085,
        "db": 3306
      },
      "databases": {
        "auth": "realmd",
        "characters": "characters",
        "world": "mangos",
        "extra": [
          "logs"
        ]
      },
      "realmlist": {
        "table": "realmlist",
        "address_column": "address",
        "local_address_column": null
      },
      "accounts": {
        "scheme": "mangos_srp6"
      },
      "console": {
        "prompt": "mangos>",
        "prompt_precedes_answer": false
      },
      "client": {
        "version": "2.4.3",
        "build": 8606,
        "notes": [
          "A Vanilla client is the wrong version — the installer checks for this."
        ]
      }
    },
    {
      "id": "wow-vanilla",
      "name": "WoW Vanilla",
      "status": "beta",
      "description": "Vanilla (1.12.1) on CMaNGOS with the CMaNGOS playerbots fork.",
      "emulator": {
        "name": "CMaNGOS mangos-classic + cmangos/playerbots + classic-db",
        "sources": [
          {
            "repo": "cmangos/mangos-classic",
            "dest": "src/mangos-classic"
          },
          {
            "repo": "cmangos/playerbots",
            "dest": "src/mangos-classic/src/modules/Bots"
          },
          {
            "repo": "cmangos/classic-db",
            "dest": "src/classic-db"
          }
        ]
      },
      "install": {
        "platforms": [
          "linux"
        ],
        "script": "wow-vanilla/install-wow-vanilla.sh",
        "default_server_dir": "wow-vanilla-server",
        "requires_client_dir": true,
        "password": {
          "mode": "generated",
          "file": ".db_password",
          "prefix": "vanilla-"
        }
      },
      "containers": {
        "db": "vanilla-db",
        "auth": "vanilla-realmd",
        "world": "vanilla-mangosd",
        "services": ["db", "realmd", "mangosd"]
      },
      "ports": {
        "auth": 3724,
        "world": 8085,
        "db": 3306
      },
      "databases": {
        "auth": "realmd",
        "characters": "characters",
        "world": "mangos",
        "extra": [
          "logs"
        ]
      },
      "realmlist": {
        "table": "realmlist",
        "address_column": "address",
        "local_address_column": null
      },
      "accounts": {
        "scheme": "mangos_srp6"
      },
      "console": {
        "prompt": "mangos>",
        "prompt_precedes_answer": false
      },
      "client": {
        "version": "1.12.1",
        "build": 5875,
        "notes": [
          "Community repacks (realmlist.wtf at top level, no locale folder) are detected and warned about."
        ]
      }
    },
    {
      "id": "wow-tortoise",
      "name": "WoW Tortoise",
      "status": "wip",
      "description": "Tortoise (the Turtle-WoW solo fork on MaNGOS Zero), source-compiled in Docker. Installer is work-in-progress and unverified with a real client.",
      "emulator": {
        "name": "Penqle/tortoise-wow (MaNGOS Zero fork)",
        "sources": [
          {
            "repo": "Penqle/tortoise-wow",
            "dest": "src/tortoise-wow"
          }
        ]
      },
      "install": {
        "platforms": [
          "linux"
        ],
        "script": "wow-tortoise/install-tortoise-wow-wsl.sh",
        "default_server_dir": "tortoise-wow-server",
        "requires_client_dir": true,
        "password": {
          "mode": "generated",
          "file": ".db_password",
          "prefix": "tortoise-"
        }
      },
      "containers": {
        "db": "tortoise-db",
        "auth": "tortoise-realmd",
        "world": "tortoise-mangosd",
        "services": ["db", "realmd", "mangosd"]
      },
      "ports": {
        "auth": 3724,
        "world": 8090,
        "db": 3306
      },
      "databases": {
        "auth": "tw_logon",
        "characters": "tw_char",
        "world": "tw_world",
        "extra": [
          "tw_logs"
        ]
      },
      "realmlist": {
        "table": "realmlist",
        "address_column": "address",
        "local_address_column": null
      },
      "accounts": {
        "scheme": "mangos_sha"
      },
      "console": {
        "prompt": "mangos>",
        "prompt_precedes_answer": false
      },
      "client": {
        "version": "1.18.1",
        "build": 7272,
        "notes": [
          "Only the custom Turtle-WoW 1.18.1 client (build 7272) works; any other build will not connect."
        ]
      }
    }
  ]
}
