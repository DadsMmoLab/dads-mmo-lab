+package pvf
+
+// 覆盖 unwrap_scan.go 的全文件扫描回退，对应 Python 侧的 scripts/test_pvf_wrapper_keys.py：
+// 合成 RSA/AES 夹具，**不含任何真实密钥**。
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/pem"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// scanLiterals 造一对 PEM 私钥 + 大写十六进制 AES 字面量（扫描回退只认大写，与真实 DFO.exe 一致）。
+func scanLiterals(t *testing.T) (*rsa.PrivateKey, []byte, []byte, []byte) {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	privatePEM := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)})
+	aesKey := randomBytes(t, 32)
+	return key, privatePEM, aesKey, []byte(strings.ToUpper(hex.EncodeToString(aesKey)))
+}
+
+// writeScanSkDat 按 writeSyntheticClient 同样的规则造 sk.dat（480 字节：prefix=256 只加密前段，
+// 其余透传，顺带覆盖“不整除”的边界），返回期望解出的段密钥。
+func writeScanSkDat(t *testing.T, dir string, key *rsa.PrivateKey, aesKey []byte) [][]byte {
+	t.Helper()
+	keys := randomBytes(t, 15*wrapperKeySize)
+	wrapped := append([]byte(nil), keys...)
+	aesCBCZeroIVEncrypt(t, aesKey, wrapped[:256])
+	writeFile(t, filepath.Join(dir, "sk.dat"), rsaBlocks(t, key, wrapped))
+	return splitKeys(keys)
+}
+
+// 非 PE 的假 exe（固定 VA 必失败）+ 诱饵钥在前、真实钥在后：扫描回退必须取回真实钥。
+func TestWrapperKeysScanFallbackRecoversKeys(t *testing.T) {
+	dir := t.TempDir()
+	key, realPEM, aesKey, aesHex := scanLiterals(t)
+	_, decoyPEM, _, decoyHex := scanLiterals(t)
+	want := writeScanSkDat(t, dir, key, aesKey)
+
+	var exe bytes.Buffer
+	exe.Write(randomBytes(t, 4096))
+	exe.Write(decoyPEM)
+	exe.WriteString("\x00\x00")
+	exe.Write(decoyHex)
+	exe.Write(make([]byte, 0x300))
+	exe.Write(realPEM)
+	exe.Write(make([]byte, 0x40))
+	exe.Write(aesHex)
+	exe.Write(randomBytes(t, 4096))
+	writeFile(t, filepath.Join(dir, "DFO.exe"), exe.Bytes())
+
+	if _, err := wrapperKeysFixedVA(dir); err == nil {
+		t.Fatal("fixed-VA path unexpectedly succeeded on a non-PE file")
+	}
+	got, err := wrapperKeys(dir)
+	if err != nil {
+		t.Fatalf("wrapperKeys: %v", err)
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %d keys, want %d", len(got), len(want))
+	}
+	for index := range want {
+		if !bytes.Equal(got[index], want[index]) {
+			t.Fatalf("key %d differs", index)
+		}
+	}
+}
+
+// 2.38.3.25 的形态：合法 PE，但两个字面量槽只剩运行期残值 0x127；真实字面量在文件别处。
+func TestWrapperKeysScanFallbackOnResidueSlots(t *testing.T) {
+	dir := t.TempDir()
+	key, realPEM, aesKey, aesHex := scanLiterals(t)
+	want := writeScanSkDat(t, dir, key, aesKey)
+
+	file := syntheticPE(realPEM, aesHex)
+	raw := file[syntheticSectionRaw:]
+	binary.LittleEndian.PutUint64(raw[syntheticSlotOffset:], 0x127)
+	binary.LittleEndian.PutUint64(raw[syntheticSlotOffset+8:], 0x127)
+	// 原位置的 PEM 与 hex 相距超过 0x200，不能配对；按真实 exe 的布局在文件尾再放一组。
+	file = append(file, realPEM...)
+	file = append(file, 0, 0, 0, 0)
+	file = append(file, aesHex...)
+	writeFile(t, filepath.Join(dir, "DFO.exe"), file)
+
+	if _, err := wrapperKeysFixedVA(dir); err == nil || !strings.Contains(err.Error(), "0x127") {
+		t.Fatalf("fixed-VA error = %v, want the residue-pointer diagnosis", err)
+	}
+	got, err := wrapperKeys(dir)
+	if err != nil {
+		t.Fatalf("wrapperKeys: %v", err)
+	}
+	if len(got) != len(want) || !bytes.Equal(got[0], want[0]) || !bytes.Equal(got[len(got)-1], want[len(want)-1]) {
+		t.Fatal("scan fallback returned the wrong keys")
+	}
+}
+
+// 没有任何候选能解开 sk.dat 时必须报错（而不是返回一套错钥）。
+func TestWrapperKeysScanNoUsableKey(t *testing.T) {
+	dir := t.TempDir()
+	key, _, aesKey, _ := scanLiterals(t)
+	writeScanSkDat(t, dir, key, aesKey)
+	_, decoyPEM, _, decoyHex := scanLiterals(t)
+	writeFile(t, filepath.Join(dir, "DFO.exe"), append(append(append(randomBytes(t, 512), decoyPEM...), 0), decoyHex...))
+
+	if _, err := wrapperKeys(dir); err == nil || !strings.Contains(err.Error(), "sk.dat") {
+		t.Fatalf("error = %v, want an sk.dat diagnosis", err)
+	}
+}
