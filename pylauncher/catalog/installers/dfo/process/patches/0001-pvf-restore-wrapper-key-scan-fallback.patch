+package pvf
+
+import (
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+// 取钥的全文件扫描回退：把 2026-10-04 的 Python 修复（docs/进度-20261004-wrapper_keys多版本密钥提取修复.md）
+// 补回 Go 实现——Go 迁移时这段回退没有带过来。固定 VA 槽位只在 2.38.2.34 里存着包装字面量；
+// 2.38.3.25 的这两个槽位只剩运行期残值（指针 0x127），剥壳因此报「VA 0x127 低于 ImageBase」，
+// 内层 PVF 生成中断。与 pvf_archive.wrapper_keys() 相同的两段式：
+//  1. 固定 VA 快路径（wrapperKeysFixedVA，即原 Go 实现）；
+//  2. 全文件扫描：每个 PEM 私钥块，配对其结束后 0x200 字节内首个 64 位大写十六进制串；
+//     只有真能解开 sk.dat 的组合才算数（exe 里那把无关的 MIICeQ 钥在这里自然剔除）。
+
+var wrapperPEMBlock = regexp.MustCompile(`(?s)-----BEGIN (?:RSA )?PRIVATE KEY-----.*?-----END (?:RSA )?PRIVATE KEY-----`)
+
+// wrapperAESWindow 是 PEM 块结束后寻找 AES 十六进制串的窗口（脚本里的 0x200）。
+const wrapperAESWindow = 0x200
+
+func wrapperKeys(clientDir string) ([][]byte, error) {
+	keys, fixedErr := wrapperKeysFixedVA(clientDir)
+	if fixedErr == nil {
+		return keys, nil
+	}
+	keys, scanErr := wrapperKeysScan(clientDir)
+	if scanErr == nil {
+		return keys, nil
+	}
+	return nil, fmt.Errorf("固定 VA 取钥失败（%v），全文件扫描回退也失败（%v）", fixedErr, scanErr)
+}
+
+func wrapperKeysScan(clientDir string) ([][]byte, error) {
+	exe, err := os.ReadFile(filepath.Join(clientDir, "DFO.exe"))
+	if err != nil {
+		return nil, fmt.Errorf("读取客户端 DFO.exe 失败：%w", err)
+	}
+	ciphertext, err := os.ReadFile(filepath.Join(clientDir, "sk.dat"))
+	if err != nil {
+		return nil, fmt.Errorf("读取 sk.dat 失败：%w", err)
+	}
+	blocks := wrapperPEMBlock.FindAllIndex(exe, -1)
+	tried := 0
+	for _, span := range blocks {
+		end := span[1] + wrapperAESWindow
+		if end > len(exe) {
+			end = len(exe)
+		}
+		aesHex := lastHexRunOf64(exe[span[1]:end])
+		if aesHex == nil {
+			continue
+		}
+		tried++
+		if keys, err := deriveWrapperKeys(exe[span[0]:span[1]], aesHex, ciphertext); err == nil {
+			return keys, nil
+		}
+	}
+	return nil, fmt.Errorf("DFO.exe 里 %d 个 PEM 块、%d 组候选都解不开 sk.dat（三件套不配套？）", len(blocks), tried)
+}
+
+// lastHexRunOf64 复刻正则 `[0-9A-F]{64}(?![0-9A-F])` 的最左匹配：第一段长度 ≥64 的大写
+// 十六进制串的最后 64 个字符。
+func lastHexRunOf64(window []byte) []byte {
+	isHex := func(b byte) bool { return (b >= '0' && b <= '9') || (b >= 'A' && b <= 'F') }
+	run := 0
+	for i, b := range window {
+		if !isHex(b) {
+			run = 0
+			continue
+		}
+		run++
+		if run >= 64 && (i+1 == len(window) || !isHex(window[i+1])) {
+			return window[i-63 : i+1]
+		}
+	}
+	return nil
+}
+
+// deriveWrapperKeys 与 wrapperKeysFixedVA 的后半段相同：RSA 分块解 sk.dat → 前缀按 256 对齐
+// 做 AES-CBC → 每 32 字节一把段密钥。任何一步失败都返回错误，供候选筛选。
+func deriveWrapperKeys(privatePEM, aesKeyLiteral, ciphertext []byte) ([][]byte, error) {
+	private, err := parseWrapperPrivateKey(privatePEM)
+	if err != nil {
+		return nil, err
+	}
+	size := private.Size()
+	if size <= 0 || len(ciphertext) == 0 || len(ciphertext)%size != 0 {
+		return nil, fmt.Errorf("sk.dat 长度 %d 不是 RSA 模长 %d 的整数倍", len(ciphertext), size)
+	}
+	plain := make([]byte, 0, len(ciphertext))
+	for offset := 0; offset < len(ciphertext); offset += size {
+		block, err := private.Decrypt(nil, ciphertext[offset:offset+size], nil)
+		if err != nil {
+			return nil, fmt.Errorf("sk.dat 第 %d 块 RSA/PKCS#1 v1.5 解密失败：%w", offset/size+1, err)
+		}
+		plain = append(plain, block...)
+	}
+	aesKey, err := hex.DecodeString(strings.TrimSpace(string(aesKeyLiteral)))
+	if err != nil {
+		return nil, fmt.Errorf("AES key 候选不是十六进制：%w", err)
+	}
+	prefix := len(plain) / wrapperKeyQuantum * wrapperKeyQuantum
+	head, err := aesCBCZeroIVDecrypt(aesKey, plain[:prefix:prefix])
+	if err != nil {
+		return nil, fmt.Errorf("解密段密钥失败：%w", err)
+	}
+	plain = append(head, plain[prefix:]...)
+	if len(plain) == 0 || len(plain)%wrapperKeySize != 0 {
+		return nil, fmt.Errorf("段密钥长度 %d 不是 %d 的整数倍", len(plain), wrapperKeySize)
+	}
+	keys := make([][]byte, 0, len(plain)/wrapperKeySize)
+	for offset := 0; offset < len(plain); offset += wrapperKeySize {
+		keys = append(keys, plain[offset:offset+wrapperKeySize])
+	}
+	return keys, nil
+}
