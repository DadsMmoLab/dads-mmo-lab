# generated by Yu'lon — BUILD-ONLY overlay for the native install.
#
# NEVER auto-loaded. Compose picks up docker-compose.yml plus
# docker-compose.override.yml on its own; this file is merged in ONLY when the
# engine passes it explicitly:
#
#     docker compose -f docker-compose.yml -f docker-compose.override.yml \
#                    -f docker-compose.build.yml build
#
# so a post-install `up` can never start a multi-hour rebuild, and the settings
# surface's YAML writer never touches build config. Naming any -f at all
# disables auto-loading, which is why the other two files are listed too — a
# bare `docker compose build` in this directory builds NOTHING and exits 0.
# `docker.build_staged()` is the only thing allowed to spell that command.
#
# `dockerfile:` IS NOT OPTIONAL. AzerothCore keeps its Dockerfile at
# apps/docker/Dockerfile, not at the repo root, so omitting this makes compose
# look for <checkout>/Dockerfile and fail with "failed to read dockerfile" —
# which is exactly how the Rust launcher's first real native build died
# (2026-07-31), after cloning 600+ MB and five green stages of unit tests
# against a fake docker.
#
# The four targets are the multi-stage Dockerfile's stages in the cloned
# checkout; the context is the server dir, which IS that checkout.
#
# `x-yulon-buildx-group` (T525): the world and auth servers read exactly the
# same files from the context (the `build` stage's sources and the runtime's
# entrypoint), so they build on one buildx config and keep ONE cached copy of
# that context between them instead of one each. Only targets whose reads are
# identical may share a group: a shared copy is synced to whatever the current
# target reads. Compose ignores `x-` keys; `docker.build_staged()` reads it.
services:
  ac-worldserver:
    x-yulon-buildx-group: server-source
    build:
      context: {{BUILD_CONTEXT}}
      dockerfile: apps/docker/Dockerfile
      target: worldserver

  ac-authserver:
    x-yulon-buildx-group: server-source
    build:
      context: {{BUILD_CONTEXT}}
      dockerfile: apps/docker/Dockerfile
      target: authserver

  ac-db-import:
    build:
      context: {{BUILD_CONTEXT}}
      dockerfile: apps/docker/Dockerfile
      target: db-import

  ac-client-data-init:
    build:
      context: {{BUILD_CONTEXT}}
      dockerfile: apps/docker/Dockerfile
      target: client-data
