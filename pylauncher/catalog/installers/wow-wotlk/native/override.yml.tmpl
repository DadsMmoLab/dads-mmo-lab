# generated by Yu'lon — runtime settings for the native stack.
#
# THIS FILE BELONGS TO THE SETTINGS SURFACE, not to the install engine. Compose
# auto-loads it next to docker-compose.yml, and whatever writes settings next
# will read and rewrite `.services.ac-worldserver.environment` here — a YAML
# writer keeps sibling keys but drops comments and restyles what it emits, so
# this header will not survive the first save from the app. That is exactly why
# nothing structural (services, ports, image refs, build config) may live here.
#
# Do NOT add a ports: entry to this file. Compose CONCATENATES ports lists
# across files, so it would publish a SECOND binding rather than replacing the
# base one — and `test_composegen.py` fails the build if one appears.
services:
  ac-worldserver:
    volumes:
      # LOAD-BEARING. The playerbots DB updater scans /azerothcore/modules at
      # boot and shuts the worldserver down when it is missing — found live
      # during the Rust launcher's migration. It sits here, beside the env the
      # settings surface already owns, so the round-trip through that writer is
      # exercised by the thing that uses it.
      - ./modules:/azerothcore/modules
    environment:
{{ENVIRONMENT}}
