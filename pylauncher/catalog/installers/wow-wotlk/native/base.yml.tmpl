# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# WoW WotLK (AzerothCore + playerbots) for the native install engine
# (roadmap 6.2). THREE FILES, and the split is the point:
#
#   * docker-compose.yml       (this file) name:, services, container names,
#     image refs, ALL ports, binds, volumes, depends_on, healthchecks.
#   * docker-compose.override.yml   runtime AC_* env and the ./modules mount,
#     nothing structural — it is auto-loaded AND rewritten by whatever settings
#     surface comes next, and a YAML writer keeps only what it understands.
#   * docker-compose.build.yml      build:/target: only, never auto-loaded, so
#     a post-install `up` can never start a multi-hour rebuild.
#
# PROVENANCE — read this before changing a line. The shape below is the Rust
# launcher's `native-compose.yml.tmpl` (`git show origin/rust-main:crates/
# dml-wow/data/native-compose.yml.tmpl`), which was itself copied from a
# WORKING migrated server rather than invented, reconciled against this repo's
# own Linux installer override and against `pyplan/rust-prior-art.md` §2.
#
# IT HAS SINCE BEEN DIFFED, and this line used to say it had not. On 2026-08-24
# `docker compose config` on the proven yulon-ubuntu install was compared with
# what this template renders: every service, container name, port, `depends_on`
# edge and healthcheck matched, and the one real difference — the Linux
# script's playerbot bot counts, missing here — now ships as data in
# `catalog.json`'s `install.native.azerothcore.world_env`. What that proves is
# that the file RESOLVES, not that it builds or starts or serves a client; the
# gate items in `pyplan/phase6-decisions.md` that cover those are still open.
#
# THE IMAGE TAG IS WRITTEN IN, NOT INTERPOLATED. Every other host-visible
# value here is spelled `${VAR:-default}` because something WRITES that
# variable: the port-conflict remedy appends `DOCKER_DB_EXTERNAL_PORT=13306`
# to `.env`, a SOAP setup writes the whole SOAP binding. Nothing writes
# `IMAGE_TAG` — `composegen.py` substitutes `{{IMAGE_TAG}}` at generation time
# and no code path puts that key in `.env`. The wrapper it used to carry was
# therefore indirection with no writer and exactly one effect: a hand-edited
# `.env` would retag the build while `built_image_refs()` kept asking the
# daemon about the derived default, so `images_built()` would answer "not
# built" forever and every resume would re-run a multi-hour compile — the same
# defect that was just measured and fixed from the other direction. Five
# reviewers refused to leave that documented in a test and called for it to be
# closed; this is the close (2026-08-24).
#
# CONTAINER NAMES ARE A CONTRACT, and they are deliberately the same `ac-*`
# names every Linux install in the wild carries: the console attach, the repair
# button, the backup `docker exec ac-database mysqldump` and every archived
# guide address them by name. The per-install separation lives in `name:`
# instead, which is also what keys the named volumes.
name: {{PROJECT_NAME}}

services:
  ac-database:
    container_name: ac-database
    image: mysql:8.4
    networks: [ac-network]
    ports:
      # Loopback ONLY. Nothing off this machine has business reaching MySQL,
      # and the launcher's own maintenance path talks to it through
      # `docker exec`, not over the network. The variable name is a contract
      # with the port-conflict remedy, which appends
      # DOCKER_DB_EXTERNAL_PORT=13306 to .env when 3306 is taken.
      - "127.0.0.1:${DOCKER_DB_EXTERNAL_PORT:-{{DB_PORT}}}:3306"
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}}
    volumes:
      - db-data:/var/lib/mysql
    restart: unless-stopped
    healthcheck:
      # Probes the way a CONSUMER does: over TCP, addressed by service name,
      # from the compose network. Upstream's copy has no `-h` at all, so it
      # rides the unix socket and "healthy" means only "a local client can log
      # in" — while `ac-db-import`, both servers and the maintenance path all
      # reach the database over TCP as `ac-database:3306`.
      #
      # The first version of this fix used `-h 127.0.0.1`, which an adversarial
      # review (Codex, 2026-08-24) correctly called out as still the wrong
      # interface: loopback inside the container is not the interface consumers
      # arrive on, so the probe did not establish what the comment claimed. It
      # is true that MySQL's default bind is `*`, which makes the two ready at
      # the same instant — but "the claim happens to hold" is not the same as
      # "the probe proves it", and this one now proves it.
      #
      # This is NOT a reproduced fix. The install of 2026-08-24 died with
      # `Can't connect to MySQL server on 'ac-database:3306' (111)` 0.3 s after
      # compose called the database healthy, and the socket/TCP split was the
      # inferred cause. It did NOT reproduce: 10 fresh-volume runs on
      # yulon-ubuntu — 5 with upstream's spelling, 5 with `-h 127.0.0.1
      # --protocol=TCP`, `depends_on: service_healthy`, and a second container
      # connecting to `ac-database:3306` — all connected first try.
      #
      # READ THAT COUNT CAREFULLY: those 10 runs predate this line. They tested
      # `-h 127.0.0.1`, which is what shipped before the review above. The
      # spelling now here was verified separately and once — a probe project
      # with this exact `test:`, `depends_on: service_healthy`, and a second
      # container that connected on the first try. So the timing claim below
      # (healthy in the same 17.1-18.2 s as upstream's) is measured of the
      # loopback spelling, and inherited by this one on the argument that
      # neither changes when the server starts listening, not on a rerun.
      # Corrected after a doc-truth sweep found this comment claiming the 10
      # runs used "this exact healthcheck" when they used the older one.
      # See `pyplan/checklist.md`.
      #
      # ONE COUPLING, WORTH KNOWING BEFORE YOU HARDEN THIS SERVICE. Root over
      # TCP works only because the official image's entrypoint defaults
      # `MYSQL_ROOT_HOST` to `%` and so creates `root@%` — verified on a fresh
      # volume, 2026-08-24: `SELECT CURRENT_USER()` over TCP returns `root@%`,
      # and the entrypoint's own guard is `[ -n "$MYSQL_ROOT_HOST" ] && [
      # "$MYSQL_ROOT_HOST" != 'localhost' ]`. A review seat predicted this
      # probe could NEVER authenticate for want of that variable; the evidence
      # refuted it. But the refutation names the tripwire: adding
      # `MYSQL_ROOT_HOST: localhost` here — a plausible hardening — deletes
      # `root@%`, and this healthcheck then never passes, so every waiter hangs
      # on a database that is running and fine.
      test: "/usr/bin/mysql -h ac-database --protocol=TCP --user=root --password=$$MYSQL_ROOT_PASSWORD --execute \"SHOW DATABASES;\""
      interval: 5s
      timeout: 10s
      retries: 40

  ac-db-import:
    container_name: ac-db-import
    image: {{IMAGE_PREFIX}}db-import:{{IMAGE_TAG}}
    networks: [ac-network]
    environment:
      AC_DATA_DIR: "/azerothcore/env/dist/data"
      AC_LOGS_DIR: "/azerothcore/env/dist/logs"
      AC_LOGIN_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_auth"
      AC_WORLD_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_world"
      AC_CHARACTER_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_characters"
      # The playerbots schema. Its absence is the gap this file was written to
      # close: the one-shot creates only the databases it is told about, and an
      # import that never heard of acore_playerbots leaves a worldserver that
      # cannot start its bots.
      AC_PLAYERBOTS_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_playerbots"
    {{CONTAINER_USER}}
    volumes:
      - ./env/dist/etc:/azerothcore/env/dist/etc
      - ./env/dist/logs:/azerothcore/env/dist/logs
      # The modules tree, because the import applies every module's own
      # data/sql/db-auth and db-characters updates as well as AzerothCore's.
      - ./modules:/azerothcore/modules
    depends_on:
      ac-database:
        condition: service_healthy

  ac-client-data-init:
    container_name: ac-client-data-init
    image: {{IMAGE_PREFIX}}client-data:{{IMAGE_TAG}}
    volumes:
      - client-data:/azerothcore/env/dist/data
    # UPSTREAM'S DOWNLOADER CANNOT RESUME, so a flaky link never finishes:
    # `inst_download_client_data` is `curl -L <url> > data.zip` — no --retry,
    # no -C -, and `>` TRUNCATES, so every attempt restarts at byte zero.
    # Measured on the Ubuntu box 2026-08-19: it died at 66 MB of 1140 MB with
    # `curl: (56) Recv failure: Connection reset by peer` and left the
    # worldserver in `Created` with no map data. Retrying the container is not
    # a fix; resume is the property that matters, so the fetch is replaced.
    #
    # The VERSION is read from upstream's own source rather than pinned here,
    # so an upstream bump follows automatically and cannot drift. If it cannot
    # be read we call upstream's own function — never worse than before.
    #
    # EVERY `$` IS DOUBLED: compose interpolates this string before the
    # container sees it, so `$$var` is how a shell variable survives.
    entrypoint: ["/bin/bash", "-c"]
    command:
      - |
        set -eu
        data=/azerothcore/env/dist/data
        fns=/azerothcore/apps/installer/includes/functions.sh
        ver=$$(sed -n 's/^[[:space:]]*local VERSION=//p' "$$fns" 2>/dev/null | head -1 | tr -d "\"' ")
        case "$${ver:-}" in
          v[0-9]*) ;;
          *)
            echo "yulon: cannot read client-data VERSION from $$fns — using upstream downloader"
            . "$$fns"
            inst_download_client_data
            exit $$?
            ;;
        esac
        mkdir -p "$$data"
        if [ -f "$$data/data-version" ] && grep -qx "INSTALLED_VERSION=$$ver" "$$data/data-version"; then
          echo "yulon: client data $$ver already installed"
          exit 0
        fi
        # Version-keyed name: a partial left by an OLDER version must never be
        # resumed into a newer one — that would splice two archives together.
        zip="$$data/data-$$ver.zip"
        retry_all=--retry-all-errors
        curl --help all 2>/dev/null | grep -q -- --retry-all-errors || retry_all=
        echo "yulon: downloading client data $$ver (resumable)"
        if ! curl -L --fail --retry 30 --retry-delay 10 $$retry_all --continue-at - \
             -o "$$zip" "https://github.com/wowgaming/client-data/releases/download/$$ver/data.zip"; then
          # A COMPLETE file makes the server answer 416, which --fail reports as
          # an error. "Already finished" must not read as "failed".
          echo "yulon: fetch returned non-zero — testing whether the archive is complete"
          unzip -t "$$zip" >/dev/null 2>&1 || { echo "yulon: client-data download FAILED"; exit 1; }
        fi
        # Refuse to extract a truncated archive: a half-unzipped data dir boots
        # a silently wrong server, which every check we have would call healthy.
        unzip -t "$$zip" >/dev/null
        echo "yulon: extracting client data $$ver"
        unzip -q -o "$$zip" -d "$$data/"
        rm -f "$$zip"
        echo "INSTALLED_VERSION=$$ver" > "$$data/data-version"
        echo "yulon: client data $$ver installed"

  ac-authserver:
    container_name: ac-authserver
    image: {{IMAGE_PREFIX}}authserver:{{IMAGE_TAG}}
    networks: [ac-network]
    tty: true
    restart: unless-stopped
    environment:
      AC_LOGS_DIR: "/azerothcore/env/dist/logs"
      AC_TEMP_DIR: "/azerothcore/env/dist/temp"
      AC_LOGIN_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_auth"
    {{CONTAINER_USER}}
    volumes:
      - ./env/dist/etc:/azerothcore/env/dist/etc
      - ./env/dist/logs:/azerothcore/env/dist/logs
    ports:
      # The game client connects to this from the LAN, so it is deliberately
      # NOT loopback-pinned (unlike the DB and SOAP admin ports).
      - "${DOCKER_AUTH_EXTERNAL_PORT:-{{AUTH_PORT}}}:3724"
    depends_on:
      ac-database:
        condition: service_healthy
      ac-db-import:
        condition: service_completed_successfully

  ac-worldserver:
    container_name: ac-worldserver
    image: {{IMAGE_PREFIX}}worldserver:{{IMAGE_TAG}}
    networks: [ac-network]
    # stdin + tty keep the worldserver CONSOLE attachable: the Console tab
    # drives it with `docker attach --sig-proxy=false`, and losing either turns
    # that into a silent hang (confirmed independently by this project on
    # 2026-08-21 — `docker attach` refuses a non-TTY stdin).
    stdin_open: true
    tty: true
    restart: unless-stopped
    # Measured, not inherited: three shutdowns of a populated playerbots realm
    # on yulon-ubuntu (2026-08-23) took 90.7s, 73.4s and 58.3s, almost all of
    # it draining 7400-7700 queued character saves. Compose's 10s default
    # SIGKILLs that mid-save; see docker.STOP_GRACE_SECONDS, which is the same
    # 300 seconds spelled for the CLI stop path.
    stop_grace_period: 5m
    environment:
      AC_DATA_DIR: "/azerothcore/env/dist/data"
      AC_LOGS_DIR: "/azerothcore/env/dist/logs"
      AC_LOGIN_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_auth"
      AC_WORLD_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_world"
      AC_CHARACTER_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_characters"
      AC_PLAYERBOTS_DATABASE_INFO: "ac-database;3306;root;${DB_ROOT_PASSWORD:-{{DB_PASSWORD}}};acore_playerbots"
      # Runtime settings live in docker-compose.override.yml.
    ports:
      - "${DOCKER_WORLD_EXTERNAL_PORT:-{{WORLD_PORT}}}:8085"
      # SOAP is pinned to loopback by the DEFAULT VALUE, never by an IP prefix
      # on the mapping: a later SOAP setup writes the WHOLE host binding into
      # .env as DOCKER_SOAP_EXTERNAL_PORT=127.0.0.1:7878, and a literal prefix
      # here would render 127.0.0.1:127.0.0.1:7878:7878. Compose also
      # CONCATENATES ports: across files — never add a second entry for this
      # port anywhere else.
      - "${DOCKER_SOAP_EXTERNAL_PORT:-127.0.0.1:{{SOAP_PORT}}}:7878"
    {{CONTAINER_USER}}
    volumes:
      # env/dist/etc must be bound out to the host: it is where the module
      # system reads and writes worldserver.conf and every module conf.
      - ./env/dist/etc:/azerothcore/env/dist/etc
      - ./env/dist/logs:/azerothcore/env/dist/logs
      - client-data:/azerothcore/env/dist/data/:ro
      # The ./modules source mount lives in docker-compose.override.yml.
    depends_on:
      ac-database:
        condition: service_healthy
      ac-db-import:
        condition: service_completed_successfully
      ac-client-data-init:
        condition: service_completed_successfully

networks:
  ac-network:

volumes:
  db-data:
  client-data:
