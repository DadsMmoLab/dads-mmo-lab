# generated by Yu'lon — runtime settings for the native stack.
#
# Compose auto-loads this next to docker-compose.yml. Runtime settings only:
# nothing structural (services, ports, image refs, volumes) lives here.
#
# The database credentials come from this folder's .env: the two passwords
# the engine generated at install, and a database and user named here. The
# server programs read the same MARIADB_* variables for their own login
# (upstream's docker README), and XI_NETWORK_* tells them where the database
# and the world server are: the services' own names on the project network.
x-database: &database
  MARIADB_ROOT_PASSWORD: ${MARIADB_ROOT_PASSWORD}
  MARIADB_DATABASE: xidb
  MARIADB_USER: xiadmin
  MARIADB_PASSWORD: ${MARIADB_PASSWORD}

x-server: &server
  <<: *database
  XI_NETWORK_HTTP_HOST: 0.0.0.0
  XI_NETWORK_ZMQ_IP: world
  XI_NETWORK_SQL_HOST: database

services:
  database:
    environment: *database
  database-update:
    environment: *server
  connect:
    environment: *server
  search:
    environment: *server
  profile:
    environment: *server
  world:
    environment: *server
  map:
    environment: *server
