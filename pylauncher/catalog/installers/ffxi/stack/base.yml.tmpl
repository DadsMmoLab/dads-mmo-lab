# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# The FFXI stack (LandSandBoat) for the stack install engine: a MariaDB, the
# one-shot database update and the five server programs, all from images
# published by LandSandBoat and pinned by digest in catalog.json. Every
# per-install value is a TOKEN in double braces that the engine fills, and a
# token nobody fills is an error at generation time. ${...} values are not
# tokens: compose reads them from this folder's .env, which the engine writes
# once with generated passwords and never rewrites.
#
# TWO FILES, the split every family keeps, less the build overlay (nothing is
# built):
#   * docker-compose.yml           (this file) name:, the services, container
#     names, image refs, ALL ports, volumes and start order.
#   * docker-compose.override.yml  runtime settings only, auto-loaded.
#
# PORTS ARE THE SERVER'S OWN DEFAULTS on both sides, published on 127.0.0.1
# only: the lobby hands the client the map server's address out of the
# database (127.0.0.1 out of the box), so this computer is the one that plays.
# 54230 is two listeners: the lobby's data server on TCP and the map server on
# UDP. The world server's HTTP API (8088) is not published; nothing outside
# the stack calls it.
#
# THE START ORDER is upstream's docker README's: the database must be healthy,
# then `dbtool.py update` runs to completion (it imports the database the
# first time and applies migrations after), then the servers start; the map
# server also waits for the world server it talks to over ZMQ.
#
# THE MESHES are a separate image whose only command copies them into the two
# volumes. Its service sits under the `seed` profile, which `up` never starts:
# the engine runs it once, as `compose run --rm`, so the volumes it fills are
# this project's.
name: {{PROJECT_NAME}}

x-server: &server
  image: {{IMAGE_SERVER}}
  volumes:
    - navmeshes:/server/navmeshes
    - ximeshes:/server/ximeshes

x-after-update: &after-update
  database:
    condition: service_healthy
    restart: true
  database-update:
    condition: service_completed_successfully

services:
  database:
    container_name: {{CONTAINER_DATABASE}}
    image: {{IMAGE_DATABASE}}
    command: ["--character-set-server=utf8mb4", "--collation-server=utf8mb4_general_ci"]
    volumes:
      - database:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      start_period: 10s
      interval: 10s
      timeout: 5s
      retries: 3
    restart: unless-stopped
    stop_grace_period: 30s

  database-update:
    <<: *server
    container_name: {{CONTAINER_DATABASE_UPDATE}}
    command: ["python", "/server/tools/dbtool.py", "update"]
    depends_on:
      database:
        condition: service_healthy
    restart: "no"

  connect:
    <<: *server
    container_name: {{CONTAINER_CONNECT}}
    command: ["/server/xi_connect"]
    ports:
      - "127.0.0.1:{{PORT_VIEW}}:{{PORT_VIEW}}"
      - "127.0.0.1:{{PORT_DATA}}:{{PORT_DATA}}"
      - "127.0.0.1:{{PORT_AUTH}}:{{PORT_AUTH}}"
    depends_on: *after-update
    restart: unless-stopped
    stop_grace_period: 30s

  search:
    <<: *server
    container_name: {{CONTAINER_SEARCH}}
    command: ["/server/xi_search"]
    ports:
      - "127.0.0.1:{{PORT_SEARCH}}:{{PORT_SEARCH}}"
    depends_on: *after-update
    restart: unless-stopped
    stop_grace_period: 30s

  profile:
    <<: *server
    container_name: {{CONTAINER_PROFILE}}
    command: ["/server/xi_profile"]
    ports:
      - "127.0.0.1:{{PORT_PROFILE}}:{{PORT_PROFILE}}"
      - "127.0.0.1:{{PORT_IRC}}:{{PORT_IRC}}"
    depends_on: *after-update
    restart: unless-stopped
    stop_grace_period: 30s

  world:
    <<: *server
    container_name: {{CONTAINER_WORLD}}
    command: ["/server/xi_world"]
    depends_on: *after-update
    restart: unless-stopped
    stop_grace_period: 30s

  map:
    <<: *server
    container_name: {{CONTAINER_MAP}}
    command: ["/server/xi_map"]
    ports:
      - "127.0.0.1:{{PORT_DATA}}:{{PORT_DATA}}/udp"
    depends_on:
      <<: *after-update
      world:
        condition: service_started
    restart: unless-stopped
    stop_grace_period: 30s

  meshes:
    image: {{IMAGE_MESHES}}
    profiles: ["seed"]
    volumes:
      - navmeshes:/navmeshes
      - ximeshes:/ximeshes
    restart: "no"

volumes:
  database:
  navmeshes:
  ximeshes:
