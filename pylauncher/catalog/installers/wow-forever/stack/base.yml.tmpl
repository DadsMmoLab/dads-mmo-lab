# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# WoW Forever (Classic 1.60.1, client build 70707) with Karrz's PlayerbotV2 bots, for the stack
# install engine: MySQL 8.0, a one-shot "prepare", the world server and the Battle.net login server,
# from images pinned by digest in catalog.json. The server image is ForeverCore (Karrz1/TrinityCore
# forever-bots, GPL-2) built with Yu'lon's patches; its scripts live in /opt/forever/yulon. Every
# per-install value is a TOKEN in double braces that the engine fills, and a token nobody fills is an
# error at generation time. ${...} values are not tokens: compose reads them from this folder's .env,
# which the engine writes once with generated passwords and never rewrites.
#
# TWO FILES, the split every family keeps, less the build overlay (nothing is built):
#   * docker-compose.yml           (this file) name:, the services, container names, image refs,
#     ALL ports, volumes and start order.
#   * docker-compose.override.yml  runtime settings only, auto-loaded.
#
# THE FOLDERS a player may want to read or edit are this folder's: etc/ (bnetserver.conf,
# worldserver.conf, worldserver.conf.d/), logs/, certs/ (this computer's CA; its key never leaves
# here) and downloads/ (the world database release the install fetched). The game data made from the
# player's client and the unpacked world database live in volumes, where the servers read them fast.
#
# THE START ORDER: the database must be healthy; "prepare" then runs to completion (certificates once,
# the configuration, the world database release unpacked once, the database user and the bots' shared
# database); then both servers start. bnetserver exits until worldserver has built the login tables on
# the very first start, so it restarts until it stays up. The first start imports the world database:
# about 15 minutes before worldserver prints its ready line.
#
# PORTS: the client always dials 1119 for Battle.net; the login service (REST) port is the one
# configure.sh writes into bnetserver.conf, which tells the client; the world port is the realmlist
# row's 8085. All published on 127.0.0.1 only: this computer plays.
#
# THE EXTRACTOR sits under the `seed` profile, which `up` never starts: the engine runs it once at
# install as `compose run --rm`, with the player's client folder mounted read-only at /client.
name: {{PROJECT_NAME}}

x-server: &server
  image: {{IMAGE_SERVER}}
  volumes:
    - ./etc:/srv/etc
    - ./logs:/srv/logs
    - ./certs:/srv/certs
    - ./downloads:/srv/downloads:ro
    - data:/srv/data
    - tdb:/srv/tdb
    # Yu'lon's own hotfixes update (stack/files): the world server's DBUpdater applies it once
    - ./sql/2026_11_14_00_hotfixes_yulon_spell_x_spell_visual.sql:/opt/forever/src/sql/custom/hotfixes/2026_11_14_00_hotfixes_yulon_spell_x_spell_visual.sql:ro

x-after-prepare: &after-prepare
  database:
    condition: service_healthy
    restart: true
  prepare:
    condition: service_completed_successfully

services:
  database:
    container_name: {{CONTAINER_DATABASE}}
    image: {{IMAGE_DATABASE}}
    command: ["--max-allowed-packet=1G", "--innodb-buffer-pool-size=1G"]
    volumes:
      - database:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p\"$$MYSQL_ROOT_PASSWORD\" --silent"]
      start_period: 60s
      interval: 10s
      timeout: 5s
      retries: 12
    restart: unless-stopped
    stop_grace_period: 90s

  prepare:
    <<: *server
    container_name: {{CONTAINER_PREPARE}}
    command:
      - bash
      - -c
      - /opt/forever/yulon/certs.sh && /opt/forever/yulon/configure.sh && /opt/forever/yulon/tdb.sh && /opt/forever/yulon/db-init.sh
    depends_on:
      database:
        condition: service_healthy
    restart: "no"

  world:
    <<: *server
    container_name: {{CONTAINER_WORLD}}
    command: ["/opt/forever/yulon/world.sh"]
    tty: true
    ports:
      - "127.0.0.1:{{PORT_WORLD}}:8085"
    depends_on: *after-prepare
    restart: unless-stopped
    stop_grace_period: 120s

  bnet:
    <<: *server
    container_name: {{CONTAINER_BNET}}
    command: ["/opt/forever/bin/bnetserver", "-c", "/srv/etc/bnetserver.conf"]
    tty: true
    extra_hosts:
      - "trinity.actual.battle.net:127.0.0.1"
    ports:
      - "127.0.0.1:{{PORT_BNET}}:1119"
      - "127.0.0.1:{{PORT_LOGIN}}:{{PORT_LOGIN}}"
    depends_on: *after-prepare
    restart: unless-stopped
    stop_grace_period: 20s

  extract:
    image: {{IMAGE_SERVER}}
    profiles: ["seed"]
    command: ["/opt/forever/yulon/extract.sh"]
    volumes:
      - data:/srv/data
    restart: "no"

volumes:
  database:
  data:
  tdb:
