# generated by Yu'lon — runtime settings for the native stack.
#
# (The WoW Forever stack: the banner above is the one every stack's override carries.)
#
# Compose auto-loads this next to docker-compose.yml. Runtime settings only: nothing structural
# (services, ports, image refs, volumes) lives here.
#
# The two passwords come from this folder's .env, generated once at install: MySQL's root password,
# and the "trinity" user's, which prepare writes into the servers' database logins
# (/opt/forever/yulon/configure.sh). REST_PORT is the login service port bnetserver tells the client.
# BOT_SETTINGS, when set, is appended to zz-zz-yulon.conf as "Key = value; Key = value".
x-database: &database
  MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
  DB_PASSWORD: ${DB_PASSWORD}
  DB_HOST: database

services:
  database:
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
  prepare:
    environment:
      <<: *database
      REST_PORT: "{{PORT_LOGIN}}"
      CA_NAME: "Yulon WoW Forever CA {{PROJECT_NAME}}"
      BOT_SETTINGS: ${BOT_SETTINGS:-}
