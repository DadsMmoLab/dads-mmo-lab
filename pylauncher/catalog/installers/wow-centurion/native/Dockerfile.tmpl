# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# Centurion server image (T179): thomasjteachey/TrinityCore112 on branch
# CENTURION, a TrinityCore 3.3.5 fork with its own Playerbot script module,
# compiled from the ./{{CHECKOUT}} tree the install engine cloned on the host.
# Two stages, as the CMaNGOS images have: a builder with the toolchain, a
# runtime with only the shared libraries. One image serves the authserver, the
# worldserver, the extractors and the conf source (`.conf.dist` under
# {{CORE_DIR}}/etc).
#
# The facts below are `.notes/tickets/T179-centurion-facts.md` §1, read at
# CENTURION faac5fc9. Upstream documents Ubuntu 22.04 (README.md:40); 24.04
# (GCC 13, Boost 1.83, OpenSSL 3, libmysqlclient 8.0) is above every minimum
# its CMake enforces -- CMake 3.11, GCC 10, C++20, Boost 1.71 -- and was not
# built by upstream: the first install's build is that proof.
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# The Boost components are exactly the six dep/boost/CMakeLists.txt:31-38 asks
# for. The MySQL client is Oracle's libmysqlclient and NOT MariaDB's
# Connector/C (`default-libmysqlclient-dev` would be either): built against
# Connector/C, the server refuses to start unless the run-time library is the
# same version as the build-time one (DatabaseWorkerPool.cpp:70, TCE00011),
# while libmysqlclient only needs 5.7 or newer. readline, ncurses and bz2 are
# the README's apt line (README.md:50-56); zlib, bzip2, libmpq, g3dlite,
# recast, fmt and the rest are bundled in dep/. No `git`: the build says
# -DWITHOUT_GIT=ON (below), so CMake never looks for it (CMakeLists.txt:78).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    ccache \
    cmake \
    libboost-filesystem-dev \
    libboost-iostreams-dev \
    libboost-locale-dev \
    libboost-program-options-dev \
    libboost-regex-dev \
    libboost-system-dev \
    libbz2-dev \
    libmysqlclient-dev \
    libncurses-dev \
    libreadline-dev \
    libssl-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# The core tree. .dockerignore keeps .git, the client patches, the SQL
# snapshot and the shipped DBCs out of the context: the import streams the SQL
# from the host, the DBCs are copied over the extracted ones on the host, and
# the patches are the client's, so none of the ~1.9 GB is compiled.
COPY ["{{CHECKOUT}}", "/src/core"]

WORKDIR /src/core
# The install prefix is {{CORE_DIR}}, so CONF_DIR is {{CORE_DIR}}/etc
# (cmake/platform/unix/settings.cmake:2-3), which is where the worldserver
# looks for worldserver.conf and, beside it, playerbots.conf, and where the
# compose file binds ./etc. -DWITHOUT_GIT=ON is upstream's own option
# (cmake/options.cmake:65) and belongs to this template because the template's
# .dockerignore is what keeps .git out of the context: without it
# cmake/genrev.cmake runs `git` on a tree with no repository, its revision
# becomes "+", the "unknown" fallback is skipped and configure fails at
# genrev.cmake:116 (measured, .notes/gates/t179-build-spike-2026-10-02). The
# defines after it are the catalog's (`trinitycore.dockerfile.cmake_options`):
# -DPLAYERBOT=ON is what compiles the bots at all (cmake/options.cmake:12
# defaults it off, and the realm then comes up empty) and -DTOOLS=ON builds
# the extractors.
RUN cmake -S /src/core -B /src/core/build \
        -DCMAKE_INSTALL_PREFIX={{CORE_DIR}} \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
        -DWITHOUT_GIT=ON \
        {{CMAKE_OPTIONS}}

# The compile, with ccache's store in a BuildKit cache mount, as AzerothCore's
# own Dockerfile does it (`--mount=type=cache,target=/ccache,sharing=locked`).
# BuildKit does not cache a RUN that did not finish, so a build killed half
# way recompiles from the top; the mount is what keeps the objects it had
# already made (measured on the AzerothCore build: ~1,315 of 1,829 edges came
# back from it, pyplan/checklist.md). The id is this game's own, so another
# game's build on the same machine does not evict it. It is evictable all the
# same: `docker builder prune`, or any `--no-cache` build naming this mount,
# empties it. The sloppiness is ccache's documented setting for builds with
# precompiled headers, which TrinityCore uses by default (USE_COREPCH,
# USE_SCRIPTPCH); without it every PCH compile is a cache miss.
#
# -j from catalog data: about 2 GB per compiler job was measured on
# AzerothCore, and an OOM-killed gcc presents as "dies at the same % every
# retry". The bot module's translation units are much larger than that
# (Pve/PlayerbotPveManager.cpp is 21,574 lines), and their peak is unmeasured.
ENV CCACHE_DIR=/ccache
ENV CCACHE_SLOPPINESS=pch_defines,time_macros,include_file_mtime,include_file_ctime
RUN --mount=type=cache,id=yulon-centurion-ccache,target=/ccache,sharing=locked \
    cd /src/core/build && make -j{{MAKE_JOBS}} && make install

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# The run-time halves of the builder's libraries, for the servers AND the
# extractors, which the client-data stage runs from this image. Ubuntu 24.04
# names several of them with the 64-bit time_t suffix (libssl3t64,
# libreadline8t64). libboost-thread is named although no -dev package above
# asks for it: the worldserver links libboost_thread.so.1.83.0 (`ldd`, build
# spike 2026-10-02), and it was in the image only as another package's
# dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libboost-filesystem1.83.0 \
    libboost-iostreams1.83.0 \
    libboost-locale1.83.0 \
    libboost-program-options1.83.0 \
    libboost-regex1.83.0 \
    libboost-system1.83.0 \
    libboost-thread1.83.0 \
    libbz2-1.0 \
    libmysqlclient21 \
    libncurses6 \
    libreadline8t64 \
    libssl3t64 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

# The whole prefix: bin/worldserver, bin/authserver, the four tools, and
# etc/{worldserver,authserver,playerbots}.conf.dist, which the conf stage
# copies out of the image before it sets its keys.
COPY --from=builder {{CORE_DIR}} {{CORE_DIR}}

# Fail the BUILD, naming what is missing, rather than a container at its first
# start: every program the install runs must be here, and every shared library
# each one links must resolve. The run-time package list above is not one
# upstream publishes; this is what holds it to the binaries.
RUN cd {{CORE_DIR}}/bin \
    && for program in worldserver authserver mapextractor vmap4extractor vmap4assembler mmaps_generator; do \
        [ -x "$program" ] || { echo "the build installed no $program in {{CORE_DIR}}/bin" >&2; exit 1; }; \
    done \
    && for conf in worldserver authserver playerbots; do \
        [ -f "{{CORE_DIR}}/etc/$conf.conf.dist" ] || { echo "the build installed no $conf.conf.dist in {{CORE_DIR}}/etc" >&2; exit 1; }; \
    done \
    && missing="$(ldd ./* | grep 'not found' || true)" \
    && { [ -z "$missing" ] || { echo "shared libraries missing from the runtime image: $missing" >&2; exit 1; }; }

WORKDIR {{CORE_DIR}}/bin

# Overridden by the compose file for the authserver; both services share this image.
CMD ["./worldserver"]
