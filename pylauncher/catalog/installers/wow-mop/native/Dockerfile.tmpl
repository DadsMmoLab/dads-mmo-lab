# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# Mists of Pandaria server image (T850): 1LineAtaTime/LoA-Pandaria-Playerbots on
# branch `playerbot`, a TrinityCore/SkyFire-lineage 5.4.8 fork (Legends of Azeroth
# Pandaria) with mod_playerbots ported from AzerothCore, compiled from the
# ./{{CHECKOUT}} tree the install engine cloned on the host. Two stages, as the
# CMaNGOS and Centurion images have: a builder with the toolchain, a runtime with
# only the shared libraries. One image serves the authserver, the worldserver, the
# extractors and the conf source (`.conf.dist` under {{CORE_DIR}}/etc).
#
# The facts below are `.notes/mop/GAP.md` §2 ("Dockerfile template") and §0, read at
# e135742e1891d3e653d27966da2dc70e793f203e. Upstream's own CI builds on the same
# base with the same options (.github/workflows/linux_gcc.yml: ubuntu-24.04,
# `-DTOOLS=1 -DELUNA=0`), and the README documents Ubuntu with GCC 13 and Boost
# 1.83 -- which is exactly 24.04's default toolchain. Unlike Centurion's fork this
# one needs no `-DWITHOUT_GIT`: its revision comes from `hg` and falls back to
# "Archive" (cmake/genrev.cmake), so CMake never looks for git.
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# The Boost components are exactly the five dep/boost/CMakeLists.txt asks for
# (filesystem program_options iostreams regex locale), plus libboost-system-dev,
# which the CMake package config pulls in. The MySQL client is Oracle's
# libmysqlclient and NOT MariaDB's Connector/C (`default-libmysqlclient-dev` would
# be either): built against Connector/C, the server refuses to start unless the
# run-time library is the same version as the build-time one, while libmysqlclient
# only needs 5.7 or newer (Centurion's template measured this, T179). cmake and
# ccache are the tools; zlib, bzip2, g3dlite, recast, fmt, jemalloc, StormLib and
# the rest are bundled in dep/. readline, ncurses and bz2 are the server's
# (worldserver links `-lncurses`).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    ccache \
    cmake \
    libboost-filesystem-dev \
    libboost-iostreams-dev \
    libboost-locale-dev \
    libboost-program-options-dev \
    libboost-regex-dev \
    libboost-system-dev \
    libbz2-dev \
    libmysqlclient-dev \
    libncurses-dev \
    libreadline-dev \
    libssl-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# The core tree. .dockerignore keeps .git, the SQL tree and the never-compiled
# folders out of the context: the import reads the four .sql files the
# `fetch-release` stage unpacked under release/ on the host, never the checkout's
# own snapshot, which is also left out of the clone.
COPY ["{{CHECKOUT}}", "/src/core"]

WORKDIR /src/core
# The install prefix is {{CORE_DIR}}, so CONF_DIR is {{CORE_DIR}}/etc
# (cmake/platform/unix/settings.cmake), which is where the worldserver looks for
# worldserver.conf, where the authserver looks for authserver.conf, and where the
# compose file binds ./etc. The defines after `-S`/`-B` are the catalog's
# (`trinitycore.dockerfile.cmake_options`): -DTOOLS=1 builds the extractors the
# client-data stage runs (cmake/options.cmake:14 defaults TOOLS to 0) and
# -DELUNA=0 is what upstream's CI uses (that option defaults to 1). PLAYERBOTS and
# SCRIPTS need no define: both default to 1 in this fork's cmake/options.cmake:13-16,
# and PLAYERBOTS is what compiles mod_playerbots at all. -DCMAKE_BUILD_TYPE is
# RelWithDebInfo, as upstream's CI and the handoff's prototype image both use.
RUN cmake -S /src/core -B /src/core/build \
        -DCMAKE_INSTALL_PREFIX={{CORE_DIR}} \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
        {{CMAKE_OPTIONS}}

# The compile, with ccache's store in a BuildKit cache mount, as Centurion's
# template does it. BuildKit does not cache a RUN that did not finish, so a build
# killed half way recompiles from the top; the mount is what keeps the objects it
# had already made. The id is this game's own, so another game's build on the same
# machine does not evict it. The sloppiness is ccache's documented setting for
# builds with precompiled headers, which this core uses by default (USE_COREPCH,
# USE_SCRIPTPCH).
#
# -j from catalog data (2): the handoff built this tree with JOBS=2 in about 75
# minutes on Ubuntu 24.04/GCC 13, and about 2 GB per compiler job was measured on
# AzerothCore. An OOM-killed gcc presents as "dies at the same % every retry".
ENV CCACHE_DIR=/ccache
ENV CCACHE_SLOPPINESS=pch_defines,time_macros,include_file_mtime,include_file_ctime
RUN --mount=type=cache,id=yulon-mop-ccache,target=/ccache,sharing=locked \
    cd /src/core/build && make -j{{MAKE_JOBS}} && make install

# The bots' conf, which CMake does NOT install: it lives at
# modules/mod_playerbots/config/playerbots.conf.dist in the tree
# (modules/CMakeLists.txt installs no such file). The conf stage copies each
# `<name>.conf.dist` out of the image's {{CORE_DIR}}/etc and patches it, so this
# one has to be there beside worldserver.conf.dist and authserver.conf.dist --
# and it is the file the runtime stage's symlink points at.
RUN cp /src/core/modules/mod_playerbots/config/playerbots.conf.dist {{CORE_DIR}}/etc/playerbots.conf.dist

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# The run-time halves of the builder's libraries, for the servers AND the
# extractors, which the client-data stage runs from this image. Ubuntu 24.04 names
# several of them with the 64-bit time_t suffix (libssl3t64, libreadline8t64).
# libboost-thread is named although no -dev package above asks for it: the
# worldserver links libboost_thread.so.1.83.0 (`ldd` on Centurion's build), and it
# is in the image only as another package's dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libboost-filesystem1.83.0 \
    libboost-iostreams1.83.0 \
    libboost-locale1.83.0 \
    libboost-program-options1.83.0 \
    libboost-regex1.83.0 \
    libboost-system1.83.0 \
    libboost-thread1.83.0 \
    libbz2-1.0 \
    libmysqlclient21 \
    libncurses6 \
    libreadline8t64 \
    libssl3t64 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

# The whole prefix: bin/worldserver, bin/authserver, the four tools, and
# etc/{worldserver,authserver,playerbots}.conf.dist, which the conf stage copies
# out of the image before it sets its keys.
COPY --from=builder {{CORE_DIR}} {{CORE_DIR}}

# The bots' conf is read from the PROCESS'S OWN FOLDER, not from etc/:
# mod_playerbots opens `boost::filesystem::absolute("playerbots.conf")`
# (modules/mod_playerbots/src/mod_playerbots.cpp:39-86), which under the compose
# file's `working_dir: {{CORE_DIR}}/bin` is bin/playerbots.conf. A missing file is
# FATAL there (`Load playerbots failed`, `sWorld->StopNow(1)`), so this symlink is
# what makes the worldserver find the file the conf stage writes beside
# worldserver.conf -- the one place it can be, since ./etc is bound over
# {{CORE_DIR}}/etc at run time and a symlink into the image's own etc/ would be
# shadowed by it. Relative, so it survives the COPY and needs no absolute path.
RUN ln -s ../etc/playerbots.conf {{CORE_DIR}}/bin/playerbots.conf

# Fail the BUILD, naming what is missing, rather than a container at its first
# start: every program the install runs must be here, and every shared library
# each one links must resolve. The run-time package list above is not one upstream
# publishes; this is what holds it to the binaries.
RUN cd {{CORE_DIR}}/bin \
    && programs="worldserver authserver mapextractor vmap4extractor vmap4assembler mmaps_generator" \
    && for program in $programs; do \
        [ -x "$program" ] || { echo "the build installed no $program in {{CORE_DIR}}/bin" >&2; exit 1; }; \
    done \
    && for conf in worldserver authserver playerbots; do \
        [ -f "{{CORE_DIR}}/etc/$conf.conf.dist" ] || { echo "the build installed no $conf.conf.dist in {{CORE_DIR}}/etc" >&2; exit 1; }; \
    done \
    && [ -L "./playerbots.conf" ] || { echo "{{CORE_DIR}}/bin/playerbots.conf is not the symlink the worldserver reads" >&2; exit 1; } \
    && missing="$(ldd $programs | grep 'not found' || true)" \
    && { [ -z "$missing" ] || { echo "shared libraries missing from the runtime image: $missing" >&2; exit 1; }; }

WORKDIR {{CORE_DIR}}/bin

# Overridden by the compose file for the authserver; both services share this image.
CMD ["./worldserver"]
