# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# WoW TBC server image: CMaNGOS mangos-tbc with the cmangos/playerbots module
# (nested at src/mangos-tbc/src/modules/Bots by the clone stage), compiled from
# the ./src tree the install engine cloned on the host. Two stages, as in the
# script it replaces (install-wow-tbc.sh): a builder with the toolchain, a
# runtime with only the shared libraries. The apt lists and the cmake flags are
# that script's, unchanged — it is the one arrangement of them that has built.
#
# What did change, and why:
#   * the four in-image clone steps are gone. The sources are COPY'd from the
#     build context, so ONE host checkout serves the build, the SQL import and
#     the resume check, and the revision the engine pinned is the revision that
#     compiles. A fetch inside the image is a different tree every rebuild.
#   * the "preserve SQL" step is gone with them. mangos-tbc/sql, tbc-db and the
#     Bots sql/ tree are host files now — `sql.phases` names them by their
#     `src/...` paths and the import streams them into the database — so baking
#     a second copy into the image would only be a copy that can go stale.
#   * the parallelism is data ({{MAKE_JOBS}}), not the script's literal `-j2`.
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# ca-certificates is required because --no-install-recommends strips it, and
# gcc-12 because gcc-11.4 hits an internal compiler error on TileAssembler.cpp
# (CMaNGOS warns about this in its own CMake config). `git` stays even with no
# clone left: CMaNGOS's revision header is generated by running it, and it
# degrades to a placeholder rather than failing when there is no repository.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    g++-12 \
    gcc-12 \
    git \
    libssl-dev \
    default-libmysqlclient-dev \
    libace-dev \
    libtbb-dev \
    libboost-all-dev \
    libreadline-dev \
    zlib1g-dev \
    openssl \
    p7zip-full \
    && rm -rf /var/lib/apt/lists/*

ENV CC=/usr/bin/gcc-12
ENV CXX=/usr/bin/g++-12

# The core tree, with the playerbots module already inside it. .dockerignore
# keeps the .git directories out of the context, so the revision string the
# build stamps reads as unknown; accepted — the pin lives in the catalog.
COPY src/mangos-tbc /src/mangos-tbc

WORKDIR /src/mangos-tbc
RUN mkdir -p build && cd build && \
    cmake .. \
        -DCMAKE_INSTALL_PREFIX={{CORE_DIR}} \
        -DBUILD_PLAYERBOTS=1 \
        -DBUILD_AHBOT=1 \
        -DBUILD_EXTRACTORS=1 \
        -DBUILD_GAME_SERVER=1 \
        -DBUILD_LOGIN_SERVER=1 \
        -DBUILD_TOOLS=1 \
        -DPCH=1

# -j from catalog data: 2 GB per compiler job was measured, and an OOM-killed
# gcc presents as "dies at the same % every retry".
RUN cd build && make -j{{MAKE_JOBS}} && make install

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# The runtime list is the script's, and it is not only the server's: the
# extract stage runs THIS image's `bin/tools/*` against the client, so the
# extractors' shared libraries have to be here too.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libmysqlclient21 \
    libace-dev \
    libtbb12 \
    libboost-system1.74.0 \
    libboost-filesystem1.74.0 \
    libboost-program-options1.74.0 \
    libreadline8 \
    netcat-openbsd \
    mariadb-client \
    gzip \
    && rm -rf /var/lib/apt/lists/*

# The whole prefix: bin/mangosd, bin/realmd, bin/tools/ and the etc/*.conf.dist
# the conf stage copies out of the image before it patches them.
COPY --from=builder {{CORE_DIR}} {{CORE_DIR}}

WORKDIR {{CORE_DIR}}/bin

# Overridden by the compose overlay for realmd; both services share this image.
CMD ["./mangosd"]
