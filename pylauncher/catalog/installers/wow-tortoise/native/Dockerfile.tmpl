# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# WoW Tortoise server image: Shyalya/tortoise-wow on branch
# playerbots-integration-gh — the Turtle-WoW V2 tree (a MaNGOS Zero fork) with
# the cmangos playerbots AI merged in — compiled from the ./src tree the
# install engine cloned on the host.
#
# The script it replaces (install-tortoise-wow-wsl.sh) built ONE image that
# held the toolchain and then compiled, from a `docker run`, into a host-bound
# install/ directory. Here the compile is a build stage and the result is a
# runtime image, like the other two games'. The apt list and the cmake flags
# are that script's, unchanged: they are the arrangement that has built, and
# the -dev packages are deliberately in BOTH stages because in the script the
# compiling image WAS the running image, so every one of them is also a
# runtime dependency of mangosd.
#
# Two things the runtime keeps from the source tree, on purpose:
#   * sql/ at {{CORE_DIR}}/sql — mangosd's Database.AutoUpdate.Path (set to
#     exactly that path by this entry's conf table) reads it at first boot.
#     Unverified: the script set the key and never reached ready; gate 7.6
#     asserts the update tables exist and, if not, the updates become two more
#     SQL plan phases.
#   * tools/mmap at {{CORE_DIR}}/src/tools/mmap — MoveMapGen's off-mesh and
#     settings inputs, named by the mmaps argv in catalog.json. The script fed
#     them from a host bind of src/; there is no such bind at run time here.
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config ca-certificates \
    libace-dev default-libmysqlclient-dev libmysqlclient-dev \
    libssl-dev zlib1g-dev libbz2-dev \
    libboost-thread-dev libboost-filesystem-dev libboost-system-dev \
    mariadb-client gosu \
    && rm -rf /var/lib/apt/lists/*

COPY src/tortoise-wow /src

WORKDIR /src/_build
# DEBUG_SYMBOLS=OFF slims mangosd (612M -> tens of MB). USE_ANTICHEAT=OFF:
# pointless on a solo offline server and it can flag a Proton client.
# BUILD_PLAYERBOTS=ON is the point of this fork's branch — without it the tree
# compiles into a bot-less server that boots and looks entirely healthy, and it
# is also what emits aiplayerbot.conf.dist into etc/ for the conf stage.
RUN cmake .. \
        -DCMAKE_INSTALL_PREFIX={{CORE_DIR}} \
        -DUSE_EXTRACTORS=ON -DUSE_SCRIPTS=ON -DUSE_STD_MALLOC=ON \
        -DDEBUG_SYMBOLS=OFF -DUSE_ANTICHEAT=OFF -DALLOW_TURTLE_ADDONS=ON \
        -DBUILD_PLAYERBOTS=ON

RUN make -j{{MAKE_JOBS}} && make install

RUN mkdir -p {{CORE_DIR}}/sql {{CORE_DIR}}/src/tools && \
    cp -r /src/sql/. {{CORE_DIR}}/sql/ && \
    cp -r /src/tools/mmap {{CORE_DIR}}/src/tools/mmap

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# The compiler and the build helpers are dropped; every library the script
# installed stays, because the image it installed them into is the one that ran
# mangosd, realmd and the extractors.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libace-dev default-libmysqlclient-dev libmysqlclient-dev \
    libssl-dev zlib1g-dev libbz2-dev \
    libboost-thread-dev libboost-filesystem-dev libboost-system-dev \
    mariadb-client gosu ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The whole prefix: bin/mangosd, bin/realmd, the extractors beside them, the
# etc/*.conf.dist the conf stage copies out, plus the sql/ and src/tools/mmap
# trees the two settings above point at.
COPY --from=builder {{CORE_DIR}} {{CORE_DIR}}

WORKDIR {{CORE_DIR}}/bin

# Overridden by the compose overlay for realmd; both services share this image.
CMD ["./mangosd"]
