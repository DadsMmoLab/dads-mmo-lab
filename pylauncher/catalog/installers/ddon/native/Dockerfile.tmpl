# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# The DDON server image: Arrowgene's .NET server, published from the ./{{CHECKOUT}}
# tree the install engine cloned on the host. One image, one container, every
# listener (login, game, web) in one process.
#
# NOT the checkout's own Dockerfile, which cannot build at the pinned commit: its
# .dockerignore leaves out Arrowgene.Ddon.Metrics, a project the CLI references
# (measured 2026-10-12, e2411fe). This file sits beside the checkout rather than in
# it so the two never overwrite each other.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["{{CHECKOUT}}", "/src"]
# Framework-dependent: the server runs on the runtime image's patched .NET.
RUN dotnet publish Arrowgene.Ddon.Cli -c Release -r linux-x64 --self-contained false \
        /p:Version=1.0.0.0 /p:DebugType=None /p:DebugSymbols=false -o /out \
 # A transitive Microsoft.NETCore.DotNetHostResolver 2.2.8 drops a 2019
 # libhostfxr.so and apphost into the output. With them present the host takes the
 # app for a self-contained one and exits 135, "Could not resolve CoreCLR path".
 && rm -f /out/libhostfxr.so /out/apphost

FROM mcr.microsoft.com/dotnet/aspnet:10.0
ENV DOTNET_EnableDiagnostics=0
WORKDIR /var/ddon/server
COPY --from=build /out ./
# The server writes its settings file, its compiled scripts and the SQLite
# database under its own folder, so the image's unprivileged user owns it.
RUN chown -R "$APP_UID" /var/ddon/server
USER $APP_UID
EXPOSE 52000/tcp 52099/tcp 52100/tcp
# Through the image's dotnet, for the reason the `rm` above gives.
ENTRYPOINT ["dotnet", "/var/ddon/server/Arrowgene.Ddon.Cli.dll"]
# `--service` waits for SIGTERM; without it the server waits on stdin for an "e",
# and a container has no stdin.
CMD ["server", "start", "--service"]
