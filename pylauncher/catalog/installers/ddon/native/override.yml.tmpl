# generated by Yu'lon — runtime settings for the native stack.
#
# Compose auto-loads this next to docker-compose.yml. Runtime settings only:
# nothing structural (services, ports, image refs, build config) lives here.
#
# The server reads these when it writes its settings file, which it does on the
# first start of each container. DB_ENABLE_TRACING is on by default upstream
# and logs every SQL statement the server runs: about 5,500 lines in its first
# minute (measured 2026-10-12), which buries everything the log is read for.
services:
  {{SERVICE}}:
    environment:
      DB_TYPE: sqlite
      DB_FOLDER: /var/ddon/server/Files/Database
      DB_ENABLE_TRACING: "false"
