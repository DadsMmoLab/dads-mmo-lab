# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# The DDON stack (Arrowgene) for the single-container install engine: ONE
# service, whose one process runs the login, game and web servers. Every
# per-install value is a TOKEN in double braces that the engine fills from
# catalog.json, and a token nobody fills is an error at generation time.
#
# THREE FILES, the same split as every other family's:
#   * docker-compose.yml        (this file) name:, the service, its container
#     name, image ref, ALL ports, binds and volumes.
#   * docker-compose.override.yml   runtime settings only, auto-loaded.
#   * docker-compose.build.yml      the build: block only, never auto-loaded.
#
# PORTS ARE THE SERVER'S OWN DEFAULTS on both sides. Arrowgene listens on
# 52100 (login), 52000 (game) and 52099 (web) out of its generated settings
# file, and the game port is also the one GameServerList.csv tells clients to
# dial, so a host port that differed from the container's would be a server
# that advertises a port nothing publishes.
#
# THE DATABASE IS A NAMED VOLUME, not a bind. Docker seeds a new named volume
# from the image, which carries Files/Database/Script/schema_sqlite.sql — the
# file the server creates db.sqlite from. An empty bind over that folder would
# hide it. It also keeps SQLite's locks off a Windows folder shared into the VM.
#
# THE ADVERTISED ADDRESS is ./{{ADVERTISE_DEST}}, the engine's copy of the
# checkout's GameServerList.csv, mounted over the image's. Networking rewrites
# its IpAddress column and restarts the container; nothing in the image changes.
name: {{PROJECT_NAME}}

services:
  {{SERVICE}}:
    container_name: {{CONTAINER}}
    image: {{IMAGE}}
    ports:
      - "{{PORT_LOGIN}}:{{PORT_LOGIN}}"
      - "{{PORT_GAME}}:{{PORT_GAME}}"
      - "{{PORT_WEB}}:{{PORT_WEB}}"
    volumes:
      - database:/var/ddon/server/Files/Database
      - ./{{ADVERTISE_DEST}}:/var/ddon/server/Files/Assets/GameServerList.csv:ro
    restart: unless-stopped
    stop_grace_period: 30s

volumes:
  database:
