# generated by Yu'lon — BUILD-ONLY overlay for the native install.
#
# NEVER auto-loaded: merged in only when the engine names it, through
# `docker.build_staged()`, so a later `up` can never start a rebuild.
#
# The context is the server dir. The engine's Dockerfile there COPYs the
# ./{{CHECKOUT}} tree the clone stage laid down, and its .dockerignore keeps
# everything else out of the context.
services:
  {{SERVICE}}:
    build:
      context: .
      dockerfile: Dockerfile
