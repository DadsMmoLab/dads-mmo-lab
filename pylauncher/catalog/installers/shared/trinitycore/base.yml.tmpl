# generated by Yu'lon — do not hand-edit; the install engine rewrites this file.
#
# The TrinityCore-lineage stack (Centurion, T179) for the native install
# engine. ONE template for the family, as shared/cmangos is for its three
# games: every per-game value is a TOKEN in double braces that composegen fills
# from catalog.json, and a token nobody fills is an error at generation time,
# never a literal in this file.
#
# THREE FILES, the same split as the other families' and for the same reasons:
#   * docker-compose.yml        (this file) name:, services, container names,
#     image refs, ALL ports, binds, volumes, depends_on, healthchecks.
#   * docker-compose.override.yml   runtime settings only, auto-loaded.
#   * docker-compose.build.yml      build: blocks only, never auto-loaded, so a
#     post-install `up` can never start a multi-hour rebuild.
#
# SERVICES ARE NAMED AFTER THEIR CONTAINERS ({{CONTAINER_PREFIX}}db,
# {{CONTAINER_PREFIX}}authserver, {{CONTAINER_PREFIX}}worldserver), the
# convention `docker.start_database()`'s `compose up -d --no-deps <db>` relies
# on. The servers' confs reach the database by its container name
# ({{DB_HOST}}).
#
# THE PASSWORD IS NEVER IN THIS FILE. The family generates one per install,
# keeps it in `.db_password` (0600) and hands it to compose through `.env` as
# DB_ROOT_PASSWORD; `${VAR:?message}` makes compose refuse to start without it
# rather than start a database with an empty root password.
#
# THE IMAGE TAG IS WRITTEN IN, NOT INTERPOLATED, for the reason WotLK's base
# template gives: nothing writes IMAGE_TAG into .env, and a wrapper with no
# writer only lets a hand edit desynchronise the build from the resume check.
name: {{PROJECT_NAME}}

services:
  {{CONTAINER_PREFIX}}db:
    container_name: {{DB_HOST}}
    # MySQL, not MariaDB: the snapshot's tables use utf8mb4_0900_ai_ci, which
    # MariaDB does not have (centurion/sql/import.sh:9-11). 8.4 imported the
    # whole snapshot with the same tables, rows, triggers, views and procedures
    # as upstream's 8.0 (.notes/gates/t179-mysql-proof-2026-10-02, verdict "8.4
    # OK"), and 8.0 is end-of-life. Binary logging is on by default there, so
    # the import must run as root: a non-SUPER importer fails on the first
    # trigger (ERROR 1419, same proof), and the triggers' definer is whoever
    # imported, so that account is never dropped.
    image: {{DB_IMAGE}}
    networks: [{{CONTAINER_PREFIX}}net]
    ports:
      # Loopback ONLY: nothing off this machine has business reaching the
      # database. The variable name is a contract with the port-conflict
      # remedy, which appends DOCKER_DB_EXTERNAL_PORT=13306 to .env when 3306
      # is taken.
      - "127.0.0.1:${DOCKER_DB_EXTERNAL_PORT:-{{DB_PORT}}}:3306"
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:?Yu'lon .env is missing}
    volumes:
      - db-data:/var/lib/mysql
    restart: unless-stopped
    # THE DATABASE OUTLIVES THE WORLD ON EVERY STOP PATH (T98), the same
    # script as WotLK's and the CMaNGOS family's, with mysql:8.4's client and
    # password variable. The app's Stop is `compose stop`, which stops the
    # worldserver first and this service last; a Docker DAEMON shutdown -- a
    # PC shutdown, a Docker Desktop quit, `systemctl stop docker` -- does not
    # read depends_on and signals every container at once, and the database
    # was measured gone in under 2 s while a world was still draining its
    # saves (yulon-ubuntu, 2026-09-23).
    #
    # So SIGTERM is held here while any server container is still connected
    # (a TCP client from off loopback), then passed on to mysqld. Neither of
    # this container's own clients counts: the app's `docker exec` queries
    # name no host and ride the socket, and the healthcheck below connects to
    # 127.0.0.1. The hold is bounded at 240 s: the app's stops all pass
    # `-t 300`, which overrides stop_grace_period, and 60 s is left for
    # mysqld's own shutdown (measured 1.4 s on WotLK). A count that fails is
    # logged to stderr (the client's words; the password is in MYSQL_PWD,
    # never in argv or the log) and tried again a second later: one fault
    # must not end the hold under a connected world, but five in a row stop
    # the database rather than hold it to the grace's SIGKILL. The grace is
    # the worldserver's 5m so a daemon shutdown never SIGKILLs the database
    # mid-wait. tests/test_db_outlives_world.py runs this script. `$$` is
    # compose's escape for a literal `$`.
    stop_grace_period: 5m
    entrypoint:
      - bash
      - -c
      - |
        db=
        held=
        hold() {
          [ -n "$$held" ] && return
          held=1
          i=0
          failed=0
          err=/tmp/yulon-hold-$$$$.err
          while [ $$i -lt 240 ]; do
            if left=$$(MYSQL_PWD="$$MYSQL_ROOT_PASSWORD" mysql -uroot -N -B -e "SELECT COUNT(*) FROM information_schema.PROCESSLIST WHERE ID <> CONNECTION_ID() AND HOST LIKE '%:%' AND HOST NOT LIKE '127.%' AND HOST NOT LIKE '::1%' AND HOST NOT LIKE '[::1]%'" 2>"$$err"); then
              failed=0
              [ "$${left:-0}" = 0 ] && break
              echo "yulon: holding shutdown, $$left server connection(s) still open"
            else
              failed=$$((failed + 1))
              echo "yulon: could not count server connections ($$failed of 5 in a row): $$(tr '\n' ' ' < "$$err")" >&2
              [ $$failed -ge 5 ] && break
            fi
            sleep 1
            i=$$((i + 1))
          done
          kill -TERM "$$db" 2>/dev/null
        }
        trap hold TERM INT
        docker-entrypoint.sh "$$@" &
        db=$$!
        [ -n "$$held" ] && kill -TERM "$$db"
        while kill -0 "$$db" 2>/dev/null; do wait "$$db"; done
        wait "$$db"
      - yulon-db
    command: ["mysqld"]
    healthcheck:
      # Over TCP, which is what makes it mean "ready": the official image
      # first runs a TEMPORARY server with --skip-networking to create root
      # and the volume, then stops it and starts the real one. A socket probe
      # answers during that first server, and an import let in then loses its
      # connection when it stops; a TCP probe cannot connect until the real
      # server listens. A login and a statement rather than `mysqladmin ping`,
      # which exits 0 even when the login is refused (MySQL's manual): healthy
      # here means root can log in over TCP, which is what the import and both
      # servers do next (root@%, MYSQL_ROOT_HOST's default; see WotLK's base
      # template for that tripwire). The password travels in MYSQL_PWD, never
      # in argv. 127.0.0.1 rather than this container's network name keeps the
      # probe out of the shutdown hold's count above; MySQL binds every
      # interface, so it is the same listener the other containers reach.
      test: ["CMD-SHELL", "MYSQL_PWD=\"$$MYSQL_ROOT_PASSWORD\" mysql -h 127.0.0.1 --protocol=TCP -uroot -e 'SELECT 1' >/dev/null"]
      interval: 5s
      timeout: 10s
      retries: 40
      start_period: 60s

  {{CONTAINER_PREFIX}}authserver:
    container_name: {{CONTAINER_PREFIX}}authserver
    image: {{IMAGE_PREFIX}}server:{{IMAGE_TAG}}
    networks: [{{CONTAINER_PREFIX}}net]
    # One image serves both servers, the extractors and the conf source; the
    # binaries sit in {{CORE_DIR}}/bin and read their conf from
    # {{CORE_DIR}}/etc, the compiled-in CONF_DIR -- which is why ./etc is
    # bound THERE and not somewhere a `-c` flag would have to name
    # (playerbots.conf is found only beside worldserver.conf, facts §4).
    working_dir: {{CORE_DIR}}/bin
    command: ["./authserver"]
    restart: unless-stopped
    ports:
      # The game client connects to this from the LAN, so it is deliberately
      # NOT loopback-pinned (unlike the DB port).
      - "${DOCKER_AUTH_EXTERNAL_PORT:-{{AUTH_PORT}}}:3724"
    # The AUTHSERVER_FOLDERS token after ./etc adds a bind for every folder
    # authserver.conf's catalog table says the server writes into (LogsDir),
    # from the server folder's own folder of the same name, label included
    # (T165's rule, composegen.server_folders()).
    volumes:
      - ./etc:{{CORE_DIR}}/etc{{BIND_LABEL}}{{AUTHSERVER_FOLDERS}}
    depends_on:
      {{CONTAINER_PREFIX}}db:
        condition: service_healthy

  {{CONTAINER_PREFIX}}worldserver:
    container_name: {{CONTAINER_PREFIX}}worldserver
    image: {{IMAGE_PREFIX}}server:{{IMAGE_TAG}}
    networks: [{{CONTAINER_PREFIX}}net]
    working_dir: {{CORE_DIR}}/bin
    command: ["./worldserver"]
    # stdin HELD OPEN, and not only for the console: the worldserver STOPS
    # when its stdin reaches end of file (CommandLine/CliRunnable.cpp:183-186,
    # `feof(stdin)` -> World::StopNow), so without these two it shuts itself
    # down the moment it has started. The tty also keeps the console
    # attachable (`docker attach --sig-proxy=false` refuses a non-TTY stdin).
    stdin_open: true
    tty: true
    restart: unless-stopped
    # Inherited from WotLK's measured 5m (docker.STOP_GRACE_SECONDS): a bot
    # realm drains character saves on shutdown, and compose's 10s default
    # SIGKILLs that mid-save. Not measured for Centurion.
    stop_grace_period: 5m
    ports:
      # Container-side port equals the host port: the conf sets
      # WorldServerPort to the same {{WORLD_PORT}}, so one number is the truth
      # for the realmlist row, the conf and this mapping. The command
      # channel's port (SOAP) is not here: the override publishes it, on
      # loopback only.
      - "${DOCKER_WORLD_EXTERNAL_PORT:-{{WORLD_PORT}}}:{{WORLD_PORT}}"
    volumes:
      # ./etc is where the conf stage writes and the user edits
      # (worldserver.conf, playerbots.conf beside it); ./data is what the
      # client-data and mmaps stages produce, and what DataDir points at. The
      # WORLDSERVER_FOLDERS token after ./data is the same folder rule over
      # worldserver.conf's table: its LogsDir.
      - ./etc:{{CORE_DIR}}/etc{{BIND_LABEL}}
      - ./data:{{CORE_DIR}}/data{{BIND_LABEL}}{{WORLDSERVER_FOLDERS}}
    depends_on:
      {{CONTAINER_PREFIX}}db:
        condition: service_healthy

networks:
  {{CONTAINER_PREFIX}}net:

volumes:
  db-data:
