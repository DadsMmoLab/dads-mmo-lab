# generated by Yu'lon — BUILD-ONLY overlay for the native install.
#
# NEVER auto-loaded. Compose picks up docker-compose.yml plus
# docker-compose.override.yml on its own; this file is merged in ONLY when the
# engine passes it explicitly:
#
#     docker compose -f docker-compose.yml -f docker-compose.override.yml \
#                    -f docker-compose.build.yml build
#
# so a post-install `up` can never start a multi-hour rebuild. Naming any -f at
# all disables auto-loading, which is why the other two files are listed too.
# `docker.build_staged()` is the only thing allowed to spell that command.
#
# ONE build block, on the world server: the authserver shares the image by
# reference, so compose builds the server image once and both services run it.
# The context is the server dir — the engine's Dockerfile there COPYs the core
# tree the clone stage laid down — and `dockerfile:` is spelled even though it
# is the default, because a missing key is how the Rust launcher's first real
# native build died.
#
# THE SERVICE KEY IS A TOKEN, for the reason shared/cmangos/build.yml.tmpl
# gives: compose merges overlays by service NAME, and a build block under a
# name the base file does not define is not an error compose reports — it adds
# an image-less service and builds nothing that the stack then runs.
services:
  {{CONTAINER_PREFIX}}worldserver:
    build:
      context: {{BUILD_CONTEXT}}
      dockerfile: Dockerfile
