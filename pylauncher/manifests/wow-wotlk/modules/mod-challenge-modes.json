{
  "schema_version": 1,
  "id": "mod-challenge-modes",
  "name": "Challenge Modes",
  "type": "module",
  "game": "wow-wotlk",
  "description": "Hardcore, Iron Man and other self-imposed challenge modes via a Shrine of Challenge NPC.",
  "source": {
    "repo": "nl-saw/mod-challenge-modes"
  },
  "build": {
    "rebuild": true
  },
  "sql": [
    {
      "db": "world",
      "path": "data/sql/db-world/*.sql",
      "applied_by": "db-import"
    },
    {
      "db": "characters",
      "path": "data/sql/db-characters/*.sql",
      "applied_by": "db-import"
    }
  ],
  "conf": [
    {
      "file": "env/dist/etc/modules/challenge_modes.conf",
      "keys": [
        {
          "key": "ChallengeModes.Enable"
        },
        {
          "key": "Hardcore.Enable"
        },
        {
          "key": "Hardcore.XPMultiplier"
        },
        {
          "key": "Hardcore.TalentRewards"
        },
        {
          "key": "Hardcore.ItemRewards"
        }
      ],
      "template": "conf/challenge_modes.conf.dist"
    },
    {
      "file": "env/dist/etc/worldserver.conf",
      "keys": [
        {
          "key": "EnablePlayerSettings",
          "default": "1",
          "note": "MUST be 1 or the module does nothing"
        }
      ]
    }
  ],
  "patches": [
    {
      "file": "src/ChallengeModes.cpp",
      "in_clone": true,
      "find": "float restore_percent, bool applySickness",
      "replace": "float /*restore_percent*/, bool& /*applySickness*/",
      "note": "nl-saw fork has the old OnPlayerResurrect signature (bool vs bool&); patched so it compiles against current AzerothCore. wow-manage.sh 5715-5739"
    }
  ],
  "notes": [
    "Shrine of Challenge NPC appears near starting zones."
  ]
}
