{
  "schema_version": 1,
  "id": "mod-dungeon-master",
  "name": "Dungeon Master",
  "type": "module",
  "game": "wow-wotlk",
  "description": "Roguelike dungeon challenge system.",
  "source": {
    "repo": "InstanceForge/mod-dungeon-master"
  },
  "build": {
    "rebuild": true
  },
  "sql": [
    {
      "db": "world",
      "path": "data/sql/db-world/*.sql",
      "applied_by": "db-import",
      "note": "dm_setup.sql"
    },
    {
      "db": "characters",
      "path": "data/sql/db-characters/*.sql",
      "applied_by": "db-import",
      "note": "dm_characters_setup.sql"
    }
  ],
  "conf": [
    {
      "file": "env/dist/etc/modules/mod_dungeon_master.conf",
      "keys": [
        {
          "key": "DungeonMaster.Scaling.LevelBand",
          "label": "Creature level window",
          "explain": "Creature selection window: effective_level \u00b1 this value. Default: 3.",
          "type": "int"
        },
        {
          "key": "DungeonMaster.Rewards.BaseGold",
          "label": "Base gold reward (copper)",
          "explain": "Base gold reward, in copper. Default: 50000 (5g).",
          "type": "int"
        },
        {
          "key": "DungeonMaster.Roguelike.Enable",
          "label": "Enable Roguelike Mode",
          "explain": "Master switch for Roguelike Mode.",
          "type": "bool"
        }
      ],
      "template": "conf/mod_dungeon_master.conf.dist"
    }
  ],
  "npcs": [
    {
      "entry": 500000,
      "name": "Dungeon Master",
      "auto_spawned": true,
      "note": "auto-spawns in capitals on server start"
    }
  ]
}
