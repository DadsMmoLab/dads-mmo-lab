{
  "schema_version": 1,
  "id": "mod-npc-beastmaster",
  "name": "NPC Beastmaster",
  "type": "module",
  "game": "wow-wotlk",
  "description": "Pets for every class via the White Fang NPC (or .beastmaster).",
  "source": {
    "repo": "azerothcore/mod-npc-beastmaster"
  },
  "build": {
    "rebuild": true
  },
  "sql": [
    {
      "db": "world",
      "path": "data/sql/db-world/*.sql",
      "applied_by": "db-import",
      "note": "updates.name: beastmaster_tames.sql, beastmaster_tames_inserts.sql"
    },
    {
      "db": "characters",
      "path": "data/sql/db-characters/*.sql",
      "applied_by": "db-import"
    }
  ],
  "conf": [
    {
      "file": "env/dist/etc/modules/mod_npc_beastmaster.conf",
      "keys": [
        {
          "key": "BeastMaster.Enable"
        },
        {
          "key": "BeastMaster.HunterOnly",
          "note": "set to 0 to allow non-hunters"
        },
        {
          "key": "BeastMaster.AllowedClasses"
        },
        {
          "key": "BeastMaster.MinLevel"
        }
      ],
      "template": "conf/mod_npc_beastmaster.conf.dist"
    },
    {
      "file": "env/dist/etc/worldserver.conf",
      "keys": [
        {
          "key": "Creatures.CustomIDs",
          "note": "add 601026 to silence a harmless gossip warning"
        }
      ]
    }
  ],
  "npcs": [
    {
      "entry": 601026,
      "name": "White Fang (Beastmaster)",
      "note": "Spawn manually: .npc add 601026"
    }
  ]
}
