{
  "schema_version": 1,
  "id": "mod-aoe-loot",
  "name": "AoE Loot",
  "type": "module",
  "game": "wow-wotlk",
  "description": "Loot every nearby corpse in one click.",
  "source": {
    "repo": "azerothcore/mod-aoe-loot"
  },
  "build": {
    "rebuild": true
  },
  "sql": [
    {
      "db": "world",
      "path": "data/sql/db-world/*.sql",
      "applied_by": "db-import"
    }
  ],
  "conf": [
    {
      "file": "env/dist/etc/modules/mod_aoe_loot.conf",
      "keys": [
        {
          "key": "AOELoot.Enable",
          "label": "Enable area loot",
          "explain": "Enables Module.",
          "type": "bool"
        },
        {
          "key": "AOELoot.Message",
          "label": "Area-loot message",
          "type": "bool"
        },
        {
          "key": "AOELoot.Range",
          "label": "Maximum loot range",
          "explain": "Maximum reach range search loot. Default: 55.0. Range: 5.0 - 100.0.",
          "type": "text"
        },
        {
          "key": "AOELoot.Group",
          "label": "Area loot in a group",
          "explain": "Enables area loot if the player is in a group.",
          "type": "bool"
        }
      ],
      "template": "conf/mod_aoe_loot.conf.dist"
    }
  ],
  "notes": [
    "wow-manage.sh 677-685, 6186-6193."
  ]
}
