{
  "schema_version": 1,
  "id": "mod-individual-progression",
  "name": "Individual Progression",
  "type": "module",
  "game": "wow-wotlk",
  "description": "Per-character Vanilla → TBC → WotLK content progression.",
  "source": {
    "repo": "ZhengPeiRu21/mod-individual-progression"
  },
  "build": {
    "rebuild": true
  },
  "sql": [
    {
      "db": "world",
      "path": "data/sql/db-world/*.sql",
      "applied_by": "db-import"
    },
    {
      "db": "characters",
      "path": "data/sql/db-characters/*.sql",
      "applied_by": "db-import"
    }
  ],
  "conf": [
    {
      "file": "env/dist/etc/modules/individualProgression.conf",
      "keys": [
        {
          "key": "IndividualProgression.Enable"
        },
        {
          "key": "IndividualProgression.EnforceGroupRules"
        },
        {
          "key": "IndividualProgression.VanillaPowerAdjustment"
        },
        {
          "key": "IndividualProgression.VanillaHealingAdjustment"
        },
        {
          "key": "IndividualProgression.QuestXPFix"
        }
      ],
      "template": "conf/individualProgression.conf.dist"
    }
  ]
}
