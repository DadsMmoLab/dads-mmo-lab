{
  "schema_version": 1,
  "id": "activechat",
  "name": "Azeroth Chatter",
  "type": "ale",
  "game": "wow-wotlk",
  "description": "Lore-grounded ambient world RP chat.",
  "source": {
    "repo": "svey-xyz/ActiveChat"
  },
  "requires": [
    "mod-ale"
  ],
  "deploy": [
    {
      "src": "AzerothChatter/",
      "dest": "env/dist/etc/modules/lua_scripts/AzerothChatter/",
      "rename": [
        [
          "data/chatter.lua",
          "data/chatter_data.lua"
        ],
        [
          "data/context.lua",
          "data/context_data.lua"
        ]
      ]
    }
  ],
  "patches": [
    {
      "file": "env/dist/etc/modules/lua_scripts/AzerothChatter/**/*.lua",
      "find": "require\\(([\"\\'])data\\.chatter\\1\\)",
      "replace": "require(\\1data.chatter_data\\1)",
      "regex": true
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/AzerothChatter/**/*.lua",
      "find": "([\"'])data\\.context\\1",
      "replace": "\\1data.context_data\\1",
      "regex": true,
      "note": "the quoted module name, so both spellings upstream uses are caught: require(\"data.context\") and pcall(require, \"data.context\") (logic/context.lua:26, logic/chatter.lua:66 at 3ba6603)"
    }
  ],
  "notes": [
    "ALE rejects duplicate Lua basenames across subdirs: data/chatter.lua collides with logic/chatter.lua (same for context.lua) — hence the rename + require patch. wow-manage.sh 3774-3811."
  ]
}
