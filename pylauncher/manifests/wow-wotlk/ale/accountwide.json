{
  "schema_version": 1,
  "id": "accountwide",
  "name": "Accountwide Systems",
  "type": "ale",
  "game": "wow-wotlk",
  "description": "Account-wide achievements, currency, gold, mounts, pets, playtime, PvP rank, reputation, flight paths and titles.",
  "source": {
    "repo": "Aldori15/azerothcore-eluna-accountwide"
  },
  "requires": [
    "mod-ale"
  ],
  "deploy": [
    {
      "src": "lua_scripts/AccountWide/",
      "dest": "env/dist/etc/modules/lua_scripts/accountwide/",
      "rename": [
        [
          "AccountReputation (default AC-Wotlk).lua",
          "AccountReputation.lua"
        ],
        [
          "AccountReputation (modified for Ashen Order).lua",
          "AccountReputation (modified for Ashen Order).lua.unused"
        ]
      ]
    }
  ],
  "sql": [
    {
      "db": "characters",
      "path": "sql/create_accountwide_tables.sql",
      "note": "required before first start"
    }
  ],
  "conf": [
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/*.lua",
      "keys": [
        {
          "key": "ENABLE_ACCOUNTWIDE_COMPLETED_ACHIEVEMENTS",
          "default": "{achievements}",
          "note": "in AccountAchievements.lua",
          "label": "Share completed achievements",
          "explain": "This script will allow completed achievements to be synced across all characters on the account. Once you complete an achievement, the next time you log into a different character, they will be awarded with the achievement as well.",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_CRITERIA_PROGRESS",
          "default": "{criteria}",
          "note": "in AccountAchievements.lua",
          "label": "Share achievement progress",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_CURRENCY",
          "default": "{currency}",
          "note": "in AccountCurrency.lua",
          "label": "Share currencies",
          "explain": "This script will allow currencies to be synced across all characters on your account. For example, if you have 100 Badge of Justice, all of your characters will have 100. If you spend 30, then all of your characters will now have 70.",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_MONEY",
          "default": "{money}",
          "note": "in AccountMoney.lua",
          "label": "Share gold",
          "explain": "This script essentially allows all of your characters to share a single gold fund. If you gain 100 gold on one character, then all of your characters will get that gold upon the next login. If you spend any gold, then all of your characters will subtract their gold balance.",
          "type": "bool"
        },
        {
          "key": "ENABLE_REALTIME_TICK",
          "default": "{money_realtime}",
          "note": "in AccountMoney.lua",
          "label": "Sync gold in real time",
          "explain": "Realtime tick (periodic sync).",
          "type": "bool"
        },
        {
          "key": "ENABLE_ALTBOT_REALTIME_TICK",
          "default": "{money_altbot}",
          "note": "in AccountMoney.lua",
          "label": "Sync Altbot gold in real time",
          "explain": "Only applies when ENABLE_REALTIME_TICK = true. Enable this if you want Altbots to also tick realtime; otherwise Altbots only write on save/logout.",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_MOUNTS",
          "default": "{mounts}",
          "note": "in AccountMounts.lua",
          "label": "Share mounts",
          "explain": "By default, this script allows learned mounts to be shared across all characters on the account, provided they are at least level 11.",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_PETS",
          "default": "{pets}",
          "note": "in AccountPets.lua",
          "label": "Share pet companions",
          "explain": "This script allows learned pet companions to be shared across all characters on the account.",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_PLAYTIME",
          "default": "{playtime}",
          "note": "in AccountPlaytime.lua",
          "label": "Account playtime summary",
          "explain": "This script provides a playtime summary across all characters on your account. This is similar to the `/played` command, but shows accountwide totals and a per-character breakdown in a cleaner format.",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_PVP_RANK",
          "default": "{pvp_rank}",
          "note": "in AccountPvPRank.lua",
          "label": "Share PvP rank and stats",
          "explain": "This script will sync your PvP Rank/Stats across all of your characters: Honorable Kills, Honor Points, Arena Points.",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_REPUTATION",
          "default": "{reputation}",
          "note": "in AccountReputation.lua",
          "label": "Share reputation",
          "explain": "This script allows all of the reputation progress to be shared across all of your characters. Horde factions will only be shared to horde characters. Alliance factions will only be shared to alliance characters. Neutral factions will be shared to both.",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_TAXI_PATHS",
          "default": "{taxi}",
          "note": "in AccountTaxiPaths.lua",
          "label": "Share flight paths",
          "explain": "This script synchronizes learned flight paths across all characters on your account that belong to the same faction. Due to Horde/Alliance restrictions, Horde flight paths will only be shared with other Horde characters, and Alliance flight paths will only be shared with other Alliance characters.",
          "type": "bool"
        },
        {
          "key": "ENABLE_ACCOUNTWIDE_TITLES",
          "default": "{titles}",
          "note": "in AccountTitles.lua",
          "label": "Share titles",
          "explain": "This script will synchronize earned character titles to the other characters on your account.",
          "type": "bool"
        }
      ]
    }
  ],
  "patches": [
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountAchievements.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_COMPLETED_ACHIEVEMENTS\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{achievements}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountAchievements.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_CRITERIA_PROGRESS\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{criteria}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountCurrency.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_CURRENCY\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{currency}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountMoney.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_MONEY\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{money}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountMoney.lua",
      "find": "^(\\s*local\\s+ENABLE_REALTIME_TICK\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{money_realtime}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountMoney.lua",
      "find": "^(\\s*local\\s+ENABLE_ALTBOT_REALTIME_TICK\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{money_altbot}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountMounts.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_MOUNTS\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{mounts}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountPets.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_PETS\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{pets}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountPlaytime.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_PLAYTIME\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{playtime}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountPvPRank.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_PVP_RANK\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{pvp_rank}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountReputation.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_REPUTATION\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{reputation}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountTaxiPaths.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_TAXI_PATHS\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{taxi}",
      "regex": true,
      "when": "configure"
    },
    {
      "file": "env/dist/etc/modules/lua_scripts/accountwide/AccountTitles.lua",
      "find": "^(\\s*local\\s+ENABLE_ACCOUNTWIDE_TITLES\\s*=\\s*)(true|false)",
      "replace": "\\g<1>{titles}",
      "regex": true,
      "when": "configure"
    }
  ],
  "prompts": [
    {
      "key": "achievements",
      "question": "Share completed achievements account-wide?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "criteria",
      "question": "Share achievement criteria progress account-wide?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "currency",
      "question": "Share currency account-wide?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "money",
      "question": "Share gold account-wide?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "money_realtime",
      "question": "Gold: real-time tick sync?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "money_altbot",
      "question": "Gold: include alt-bots in the real-time tick?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "mounts",
      "question": "Share mounts account-wide?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "pets",
      "question": "Share pets account-wide?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "playtime",
      "question": "Share playtime account-wide?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "pvp_rank",
      "question": "Share PvP rank account-wide?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "reputation",
      "question": "Share reputation account-wide?",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "taxi",
      "question": "Share flight paths account-wide? (needs Aldori15's mod-ale fork)",
      "kind": "bool",
      "default": "false"
    },
    {
      "key": "titles",
      "question": "Share titles account-wide?",
      "kind": "bool",
      "default": "false"
    }
  ],
  "notes": [
    "Fresh server recommended; 00_AccountWideUtils.lua is mandatory. All flags ship false upstream. wow-manage.sh 3563-3772.",
    "Upstream ships two reputation scripts and no AccountReputation.lua; a stock AzerothCore must use 'AccountReputation (default AC-Wotlk).lua' (upstream README). It is deployed as AccountReputation.lua, the file the reputation flag's patch edits (T104, after T92 made install run that patch). The Ashen Order one is for that server's modified Faction.dbc, so it is renamed to '.lua.unused' on deploy and ALE does not load it (T104). AccountPvPRank.lua's RUN_INIT_SEED_ON_STARTUP defaults true — set false after the first start.",
    "Upstream ships no AccountReputation.lua: the stock 'AccountReputation (default AC-Wotlk).lua' is deployed under that name, the file the reputation flag's patch edits (T119)."
  ]
}
