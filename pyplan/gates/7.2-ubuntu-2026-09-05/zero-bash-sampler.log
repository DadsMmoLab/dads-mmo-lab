2026-09-05T01:20:52+02:00 lineage=[none] any-sh=[  85839 bash -c cp ~/ccache-probe.sh ~/ccache-probe.v1-no-cache.sh; cp ~/ccache-probe/Dockerfile ~/ccache-probe/Dockerfile.v1 cat > ~/ccache-probe/Dockerfile <<'EOF' # Reads the ccache counters out of the SAME BuildKit cache mount the AzerothCore build uses # (apps/docker/Dockerfile:83: --mount=type=cache,target=/ccache,sharing=locked). BuildKit keys a # cache mount by its id, which defaults to the target path, so any Dockerfile naming target=/ccache # on this builder sees the same directory. # v2, 2026-09-05 01:2x: NO --no-cache. Measured in cachemount-diag3.txt: a --no-cache build that names # a cache mount RESETS it, so v1 of this probe emptied the engine ccache it was meant to read. The # NONCE build-arg is what makes the last RUN execute instead of coming from the layer cache. FROM ubuntu:24.04 RUN apt-get update && apt-get install -y --no-install-recommends ccache && rm -rf /var/lib/apt/lists/* ARG NONCE RUN --mount=type=cache,target=/ccache,sharing=locked sh -c "echo probe-$NONCE && CCACHE_DIR=/ccache ccache -s && echo --- du && du -sh /ccache" EOF cat > ~/ccache-probe.sh <<'EOF' #!/usr/bin/env bash # usage: ccache-probe.sh "<label>"   -- appends one ccache -s reading to ~/gate72-ccache-stats.txt # v2: no --no-cache (see the Dockerfile header); a nonce forces the reading RUN to execute. { echo "=== ccache -s at $(date -Is) : $1"; docker build --progress plain --build-arg NONCE=$(date +%s%N) ~/ccache-probe 2>&1 | grep -E "^#[0-9]+ [0-9.]+ |^#[0-9]+ DONE" | grep -E "probe-|Hits|Misses|Cacheable|Cache size|Local storage|du|[0-9]+[MK]\s|DONE" | tail -14; echo; } >> ~/gate72-ccache-stats.txt EOF chmod +x ~/ccache-probe.sh cp ~/kill-watcher.sh ~/kill-watcher.v1.sh sed -i "s#^LOG=.*#LOG=\${LOG:-\$HOME/gate72-press2.log}#; s#^OUT=.*#OUT=\${OUT:-\$HOME/gate72-kill-record.txt}#; s#gate72-press2#\${UNIT:-gate72-press2}#g; s#\"\$HOME/wowserver/.yulon-install.json\"#\"\${SERVER_DIR:-\$HOME/wowserver}/.yulon-install.json\"#; s#T1: after the mid-build SIGKILL of press 2#\${PROBE_LABEL:-T1: after the mid-build SIGKILL}#" ~/kill-watcher.sh sed -i "s#^LOG=\\${LOG:-\\$HOME/\\${UNIT:-gate72-press2}.log}#LOG=\${LOG:-\$HOME/gate72-press2.log}#" ~/kill-watcher.sh bash -n ~/kill-watcher.sh && echo "kill-watcher syntax ok"; grep -n "^LOG=\|^OUT=\|UNIT\|SERVER_DIR\|PROBE_LABEL" ~/kill-watcher.sh | head -12 echo "--- stop the real stack (containers kept), prune the builder, T0 with the v2 probe" echo "$(date +%H:%M:%S)  gate-71-72: cycle 2 for the ccache clause -- real stack STOPPED (containers kept), docker builder prune -af, then kill+resume on the throwaway folder ~/gate72-cancel-install with v2 probes (no --no-cache)" >> ~/claude-activity.log { echo "=== cycle 2 preparation, $(date -Is)"; echo "--- docker stop of the real stack (containers and images kept; restarted at the end)"; sg docker -c "docker stop ac-worldserver ac-authserver ac-database"; sg docker -c "docker ps -a --format \"{{.Names}} {{.Status}}\""; echo "--- ports free?"; ss -ltn | grep -E ":(3724|8085|3306) " || echo "3724/8085/3306 free"; echo "--- docker builder prune -af (the ccache mount was already empty: diag3; this makes the throwaway build a real full build rather than a layer-cache replay)"; sg docker -c "docker builder prune -af 2>&1 | tail -2"; echo "--- state of the throwaway folder"; ls -ld ~/gate72-cancel-install; cat ~/gate72-cancel-install/.yulon-install.json 2>&1; echo "--- df"; df -h ~ | tail -1; } > ~/gate72-cycle2-prep.txt 2>&1; cat ~/gate72-cycle2-prep.txt sg docker -c "~/ccache-probe.sh \"cycle2 T0: after docker builder prune -af, before the throwaway build (v2 probe, no --no-cache)\""; tail -9 ~/gate72-ccache-stats.txt] install-logs=0
