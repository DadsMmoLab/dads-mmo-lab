2026-09-05T00:54:31+02:00 lineage=[none] any-sh=[  58399 /bin/bash -c set -eu data=/azerothcore/env/dist/data fns=/azerothcore/apps/installer/includes/functions.sh ver=$(sed -n 's/^[[:space:]]*local VERSION=//p' "$fns" 2>/dev/null | head -1 | tr -d "\"' ") case "${ver:-}" in   v[0-9]*) ;;   *)     echo "yulon: cannot read client-data VERSION from $fns — using upstream downloader"     . "$fns"     inst_download_client_data     exit $?     ;; esac mkdir -p "$data" if [ -f "$data/data-version" ] && grep -qx "INSTALLED_VERSION=$ver" "$data/data-version"; then   echo "yulon: client data $ver already installed"   exit 0 fi # Version-keyed name: a partial left by an OLDER version must never be # resumed into a newer one — that would splice two archives together. zip="$data/data-$ver.zip" retry_all=--retry-all-errors curl --help all 2>/dev/null | grep -q -- --retry-all-errors || retry_all= echo "yulon: downloading client data $ver (resumable)" if ! curl -L --fail --retry 30 --retry-delay 10 $retry_all --continue-at - \      -o "$zip" "https://github.com/wowgaming/client-data/releases/download/$ver/data.zip"; then   # A COMPLETE file makes the server answer 416, which --fail reports as   # an error. "Already finished" must not read as "failed".   echo "yulon: fetch returned non-zero — testing whether the archive is complete"   unzip -t "$zip" >/dev/null 2>&1 || { echo "yulon: client-data download FAILED"; exit 1; } fi # Refuse to extract a truncated archive: a half-unzipped data dir boots # a silently wrong server, which every check we have would call healthy. unzip -t "$zip" >/dev/null echo "yulon: extracting client data $ver" unzip -q -o "$zip" -d "$data/" rm -f "$zip" echo "INSTALLED_VERSION=$ver" > "$data/data-version" echo "yulon: client data $ver installed" ] install-logs=0
