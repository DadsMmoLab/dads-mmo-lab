+def test_one_familys_pending_sql_does_not_badge_another_familys_row() -> None:
+    """T44 round 2. `sql_owed` is keyed by (family, id), not by a bare id.
+
+    Nothing makes a manifest id unique across families -- the store loads
+    `manifests/<game>/<family>/` one directory at a time and no invariant spans
+    them -- and T42 round 2 keyed the row dict, the manifest dict, the panel
+    and the tuning cards by the pair for exactly that reason. Keyed by a bare
+    id, an `ale` whose SQL was left to the importer badges a `module` of the
+    same name `Cloned, SQL not applied` over a module with no SQL at all,
+    which is a worse lie than the `Installed` it replaced.
+
+    Mutation: key `sql_owed` by the bare id again (and look it up with
+    `session.sql_owed.get(manifest.id)`) and the `module` row reads
+    `Cloned, SQL not applied`.
+    """
+    session = mp.SessionState(sql_owed={("ale", "bmah"): ("a.sql",)})
+    rows = _rows(
+        [_m("bmah"), _m("bmah", "ale")],
+        {"module": frozenset({"bmah"}), "ale": frozenset({"bmah"})},
+        session,
+    )
+
+    module_row = next(r for r in rows if r.family == "module" and r.id == "bmah")
+    ale_row = next(r for r in rows if r.family == "ale" and r.id == "bmah")
+    assert module_row.badge == mp.BADGE_INSTALLED
+    assert ale_row.badge == mp.BADGE_SQL_NOT_APPLIED
+
+
+def test_the_sql_chip_is_keyed_by_family_too_and_so_are_the_other_two() -> None:
+    """The chips were keyed by a bare id as well, and it is the same collision.
+
+    All three session facts move together: keeping one pair-keyed and two
+    id-keyed would be two rules for one ambiguity, which is what T42 round 2
+    found four places along.
+
+    Mutation: look any of the three up by `manifest.id` and the wrong family's
+    row grows the chip.
+    """
+    session = mp.SessionState(
+        rebuild_owed=frozenset({("module", "bmah")}),
+        sql_owed={("ale", "bmah"): ("a.sql",)},
