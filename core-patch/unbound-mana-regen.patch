+    // Unbound multiclass: a class with no mana of its own (warrior, rogue,
+    // death knight) has no spirit regen in its row, so the mana pool of an
+    // unlocked mana class never refilled. Such a character reads the priest's
+    // row instead. A character with no mana pool is unaffected: Regenerate()
+    // skips a power whose maximum is 0.
+    if (ChrClassesEntry const* classEntry = sChrClassesStore.LookupEntry(pclass))
+        if (classEntry->powerType != POWER_MANA)
+            pclass = CLASS_PRIEST;
+
     if (level > GT_MAX_LEVEL)
         level = GT_MAX_LEVEL;
 
